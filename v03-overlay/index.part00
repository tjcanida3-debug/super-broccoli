<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#0c111a" />
<meta name="description" content="PitNudge: vehicle maintenance reminders, trip logs, mechanic finder, and receipts." />
<title>PitNudge · Your Ride. Right on Time.</title>
<style>
:root {color-scheme:dark;--bg:#0b1018;--panel:#151c28;--panel2:#1d2634;--line:#293342;--text:#f1f4f9;--muted:#9daabd;--red:#f45b60;--red2:#bd303d;--green:#5dd6aa;--amber:#ffca75;--blue:#80afff;--shadow:0 14px 50px #0005;}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 100% -10%,#371e27 0%,transparent 36%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;font-size:15px;line-height:1.45}button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}a{color:var(--blue)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,a:focus-visible{outline:3px solid #f78b8f;outline-offset:2px}.app{max-width:1150px;margin:0 auto;min-height:100vh}.top{position:sticky;z-index:20;top:0;background:#0d131eea;backdrop-filter:blur(18px);border-bottom:1px solid #ffffff13;padding:13px max(18px,env(safe-area-inset-left));display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{display:flex;align-items:center;gap:11px;font-size:20px;font-weight:850;letter-spacing:-.9px}.brandmark{width:39px;height:39px;border-radius:13px;background:linear-gradient(145deg,var(--red),#962932);display:grid;place-items:center;box-shadow:0 8px 18px #d1334150}.brandmark svg{width:24px;height:24px;stroke:white}.subtitle{display:block;color:var(--muted);font-size:10px;letter-spacing:.1px;font-weight:600}.vehicleSelect{max-width:190px;min-width:110px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px;color:var(--text);font-size:13px}.layout{display:grid;grid-template-columns:208px minmax(0,1fr);min-height:calc(100vh - 67px)}.sidebar{padding:23px 12px;border-right:1px solid #ffffff12}.sideItem,.bottomItem{display:flex;align-items:center;gap:12px;color:#b6c1cf;background:transparent;border:0;border-radius:12px;width:100%;padding:13px 15px;text-align:left;font-weight:700}.sideItem svg{width:20px;height:20px}.sideItem.active{background:linear-gradient(90deg,#572b36a8,transparent);color:#ff9293}.sideItem:hover,.bottomItem:hover{background:#ffffff09}.sidebarFoot{padding:20px 14px;font-size:12px;color:var(--muted)}.main{padding:26px 28px 90px;min-width:0}.pageIntro{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:22px}.eyebrow{text-transform:uppercase;color:var(--red);font-weight:800;font-size:11px;letter-spacing:1.6px}.pageIntro h1{font-size:clamp(25px,3vw,34px);line-height:1.15;letter-spacing:-1.2px;margin:7px 0}.introText{color:var(--muted);margin:5px 0 0;font-size:14px}.panel{background:linear-gradient(160deg,#1a2230,#131b27);border:1px solid #ffffff12;border-radius:19px;box-shadow:0 6px 24px #00000017;padding:20px}.panel h2{margin:0;font-size:17px;letter-spacing:-.3px}.panelHead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:15px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:15px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.stack{display:grid;gap:15px}.muted{color:var(--muted)}.small{font-size:12px}.button{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:1px solid transparent;background:var(--red);color:#160d13;font-weight:850;border-radius:11px;padding:11px 15px;line-height:1.2;text-decoration:none;white-space:normal;text-align:center}.button:hover{filter:brightness(1.1)}.button.secondary{background:#283344;color:var(--text);border-color:#ffffff0e}.button.ghost{background:transparent;border:1px solid var(--line);color:var(--text)}.button.danger{background:#6d2c34;color:white}.button.sm{font-size:12px;padding:8px 10px;border-radius:9px}.actions{display:flex;gap:8px;flex-wrap:wrap}.hero{padding:24px;background:radial-gradient(circle at 90% 5%,#6a3036 0%,transparent 45%),linear-gradient(140deg,#252b39,#151d29);border:1px solid #ffffff23}.heroRow{display:flex;align-items:center;justify-content:space-between;gap:15px}.heroCount{font-weight:850;font-size:clamp(30px,5vw,42px);letter-spacing:-1.8px;line-height:1.1}.heroLabel{font-size:13px;color:#c2ccd8}.carDrawing{opacity:.5;max-width:110px;color:#ffb7b8}.statLabel{font-size:12px;color:var(--muted)}.statNum{font-size:25px;letter-spacing:-.7px;font-weight:850;margin-top:6px}.statNum.smallnum{font-size:19px}.status{font-size:11px;border-radius:99px;padding:5px 9px;font-weight:800;display:inline-flex;align-items:center;white-space:nowrap}.status.good{background:#1a443c;color:#76e3b8}.status.soon{background:#4e3a26;color:#ffcb81}.status.due{background:#522931;color:#ff9399}.status.unknown{background:#2e3949;color:#bbcad9}.serviceItem{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 0;border-bottom:1px solid var(--line)}.serviceItem:last-child{border-bottom:0;padding-bottom:0}.serviceTitle{font-weight:750}.serviceMeta{font-size:12px;color:var(--muted);margin-top:3px}.serviceInfo{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.itemIcon{display:grid;place-items:center;flex-shrink:0;width:37px;height:37px;border-radius:12px;background:#303241;color:#ff898d}.itemIcon svg{width:19px;height:19px}.empty{padding:30px;text-align:center;border:1px dashed #4e5c6d;border-radius:18px;color:var(--muted)}.empty h2{color:var(--text);margin:0 0 8px}.empty p{margin:0 auto 16px;max-width:370px}.banner{background:#30262d;border:1px solid #754451;border-radius:13px;padding:13px 15px;color:#ffe1dd;font-size:13px}.note{background:#1c2834;border:1px solid #2c4757;border-radius:12px;padding:12px 14px;font-size:12px;color:#bfd3e3}.tabline{display:flex;gap:7px;overflow-x:auto;margin-bottom:16px;padding:2px 0 6px}.pill{border:1px solid var(--line);background:#202a37;color:#c5cfdb;border-radius:100px;padding:9px 14px;white-space:nowrap;font-size:13px;font-weight:750}.pill.selected{background:#77323d;border-color:#bc4c58;color:white}.formGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:6px;font-size:12px;color:#cbd5e1;font-weight:750}.field.wide{grid-column:1/-1}.field input,.field select,.field textarea{background:#0e1723;color:#fff;border:1px solid #364456;border-radius:10px;min-width:0;padding:12px;font-size:14px;line-height:1.25}.field textarea{min-height:80px;resize:vertical}.filePreview{width:100%;max-width:240px;max-height:150px;object-fit:cover;border-radius:9px}.record{padding:12px 0;border-top:1px solid var(--line);display:flex;gap:12px;justify-content:space-between;align-items:center}.record:first-of-type{border:0}.recordAmount{font-weight:800;font-variant-numeric:tabular-nums}.recordPhoto{height:52px;width:52px;object-fit:cover;border-radius:8px;flex:none}.resultCard{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px;border:1px solid var(--line);border-radius:13px;background:#192332}.valueLarge{font-size:30px;letter-spacing:-1px;font-weight:850}.labelRow{display:flex;align-items:center;justify-content:space-between;gap:9px}.progress{height:7px;background:#344052;border-radius:20px;margin-top:10px;overflow:hidden}.progress>span{display:block;height:100%;background:var(--red);border-radius:20px}.shopPanel{background:linear-gradient(150deg,#3d2734,#181f2c);border:1px solid #613b48;border-radius:17px;padding:20px}.mapArtwork{position:relative;height:175px;background:linear-gradient(120deg,transparent 45%,#445166 46%,#445166 49%,transparent 50%),linear-gradient(18deg,transparent 60%,#445166 61%,#445166 65%,transparent 66%),repeating-linear-gradient(0deg,#1c2b39 0,#1c2b39 36px,#263747 37px,#263747 39px),#203040;border-radius:15px;overflow:hidden;margin-bottom:15px}.mapArtwork:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 65px,#364759 66px,#364759 69px)}.mapPin{position:absolute;font-size:26px;filter:drop-shadow(0 4px 5px #0008)}.mapPin.one{top:17%;left:24%}.mapPin.two{top:52%;left:65%}.mapPin.three{top:28%;left:81%}.mapCaption{position:absolute;bottom:8px;left:9px;color:#d8e3ed;background:#151f2ed9;font-size:10px;padding:4px 8px;border-radius:7px}.bottom{display:none}dialog{border:1px solid #435168;border-radius:18px;background:#172130;color:var(--text);width:min(94vw,550px);max-height:min(85vh,760px);padding:0;box-shadow:0 25px 110px #000c}dialog::backdrop{background:#000b;backdrop-filter:blur(5px)}.dialogHead{position:sticky;top:0;background:#1b2635;padding:16px 20px;border-bottom:1px solid #3a4859;display:flex;justify-content:space-between;align-items:center}.dialogHead h2{margin:0;font-size:19px}.dialogContent{padding:18px 20px 21px;max-height:calc(85vh - 60px);overflow:auto}.xbutton{border:0;color:#eee;background:#364356;border-radius:9px;padding:5px 11px;font-size:20px}.footer{font-size:11px;color:#8996a5;margin:25px 0 10px}.toast{position:fixed;right:14px;bottom:92px;border:1px solid #607386;box-shadow:var(--shadow);background:#243244;color:#fff;padding:13px 16px;border-radius:12px;max-width:min(92vw,400px);z-index:99;display:none}.toast.show{display:block}.topTip{display:inline-flex;align-items:center;gap:5px;color:var(--muted);font-size:12px}.toggle{display:inline-flex;align-items:center;gap:10px;font-weight:700}.toggle input{width:20px;height:20px;accent-color:var(--red)}.red{color:#ff8d91}.green{color:var(--green)}.amber{color:var(--amber)}.right{text-align:right}.space{margin-top:16px}.metric{font-variant-numeric:tabular-nums}.mini{font-size:10px;color:var(--muted)}.chip{border-radius:7px;background:#293749;color:#d5e0ed;padding:5px 8px;font-size:11px;font-weight:800}
@media(max-width:820px){.layout{display:block}.sidebar{display:none}.main{padding:20px 16px 110px}.bottom{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:20;background:#111925f5;backdrop-filter:blur(16px);border-top:1px solid #ffffff20;justify-content:space-around;padding:7px 3px calc(7px + env(safe-area-inset-bottom))}.bottomItem{padding:7px 2px;gap:3px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px;font-weight:750;border-radius:10px;flex:1;max-width:92px}.bottomItem.active{color:#ff9296;background:#5c29312e}.bottomItem svg{width:21px;height:21px}.grid3{grid-template-columns:1fr 1fr}.top{padding:11px 15px}.vehicleSelect{max-width:157px}.toast{bottom:85px}}
@media(max-width:470px){.pageIntro{flex-direction:column}.pageIntro .button{align-self:flex-start}.grid3{grid-template-columns:1fr 1fr;gap:10px}.grid2{grid-template-columns:1fr;gap:11px}.panel{padding:16px}.statNum{font-size:22px}.brand{font-size:18px}.brandmark{height:36px;width:36px}.vehicleSelect{max-width:132px;font-size:12px;padding:9px 4px}.serviceItem{align-items:flex-start}.serviceInfo{gap:6px}.serviceInfo .button{padding:7px}.formGrid{grid-template-columns:1fr}.hero{padding:20px}.actions .button{flex:1}}
[hidden]{display:none!important}

.vehiclePicture{display:block;position:relative;overflow:hidden;border-radius:14px;background:radial-gradient(circle at 68% 35%,#45536766,transparent 55%),linear-gradient(145deg,#222c3e,#101923);border:1px solid #ffffff20;isolation:isolate}
.vehiclePicture .vehicleIllustration{width:100%;height:100%;display:block}
.vehiclePicture>img{display:block;width:100%;height:100%;object-fit:contain;background:#101925}
.vehiclePicture.heroPhoto{width:150px;height:110px;flex:0 0 150px}
.vehiclePicture.garagePhoto{height:174px;width:100%;margin-bottom:13px}
.vehiclePicture.formPhoto{height:162px;width:100%;margin:8px 0 12px}
.vehiclePicture .imageType{position:absolute;top:7px;right:7px;color:#e5edf5;background:#0b1420bc;padding:3px 7px;border-radius:7px;font-size:10px;font-weight:700;letter-spacing:.1px}
.vehiclePicture .pictureCredit{position:absolute;bottom:0;left:0;right:0;padding:4px 6px;background:#0b121de8;color:#edf3ff;font-size:9px;line-height:1.3;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pictureCredit a{color:#bdd7ff;text-decoration:underline}.vehiclePhotoNote{font-size:11px;color:var(--muted);margin:3px 0 9px}
@media(max-width:470px){.vehiclePicture.heroPhoto{width:112px;height:91px;flex-basis:112px}.vehiclePicture.garagePhoto{height:160px}}
</style>
</head>
<body>
<div class="app">
<header class="top"><div class="brand"><span class="brandmark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.3a8 8 0 1 1 15 0"/><path d="m12 14 5-5"/><path d="M7 18h10"/></svg></span><div>PitNudge<span class="subtitle">YOUR RIDE. RIGHT ON TIME.</span></div></div><select id="currentVehicle" class="vehicleSelect" aria-label="Selected vehicle"></select></header>
<div class="layout"><aside class="sidebar" id="sideNav"></aside><main class="main" id="content">
<section class="panel" style="margin-top:18px;max-width:660px">
<div class="eyebrow" style="margin-bottom:10px">IMPORTANT: OPEN IN CHROME</div>
<h1 style="font-size:27px;line-height:1.2;margin:0 0 10px">Google Drive is only previewing this app.</h1>
<p class="introText">The Drive preview may block PitNudge's interactive features. To use the vehicle picker and dashboard, download this HTML file, then open your downloaded copy in Chrome.</p>
<div class="note" style="margin:18px 0"><strong>On Android:</strong><ol style="padding-left:20px;line-height:1.85;margin-bottom:0"><li>Go back to the PitNudge folder in Google Drive.</li><li>Tap the three dots beside this HTML file (not inside the preview).</li><li>Choose <strong>Download</strong>.</li><li>Open the <strong>Files</strong> app &gt; <strong>Downl