>b.score-a.score);
  if(candidates.length)return candidates[0].photo;
 }
 return null;
}
function applyModelPhotoToDom(key,photo){
 document.querySelectorAll('.vehiclePicture[data-pn-key]').forEach(el=>{
  if(el.dataset.pnKey!==key)return;
  el.removeAttribute('data-pn-key');
  if(!photo)return;
  const v=db.vehicles.find(x=>modelPhotoKey(x)===key);
  // Avoid replacing a form preview if user selected a local photo while a lookup was running.
  if(el.closest('#carPhotoPreview')){
   const form=document.getElementById('vehicleEntryForm');
   if(form?.elements.namedItem('vehiclePhoto')?.files?.length)return;
  }
  const old=el.innerHTML;
  const pic=document.createElement('img');pic.alt='Example car photo; model year may differ';pic.loading='lazy';pic.referrerPolicy='no-referrer';
  pic.onerror=()=>{el.innerHTML=old;el.dataset.photoFailed='true'};
  pic.src=photo.url;
  el.innerHTML='';el.appendChild(pic);
  const tag=document.createElement('span');tag.className='imageType';tag.textContent='Example model photo';el.appendChild(tag);
  const credit=document.createElement('div');credit.className='pictureCredit';
  credit.append('Photo: '+(photo.author||'Wikimedia Commons')+' · ');
  const source=document.createElement('a');source.href=photo.page;source.target='_blank';source.rel='noopener noreferrer';source.textContent='source';credit.appendChild(source);credit.append(' · ');
  const link=document.createElement('a');link.href=photo.licenseUrl;link.target='_blank';link.rel='noopener noreferrer';link.textContent=photo.license;credit.appendChild(link);el.appendChild(credit);
 });
}
function hydrateVehiclePhotos(){
 const unmatched=[...document.querySelectorAll('.vehiclePicture[data-pn-key]')];
 for(const el of unmatched){
  const key=el.dataset.pnKey;
  const v=db.vehicles.find(x=>modelPhotoKey(x)===key)||(()=>{
   const form=el.closest('#carPhotoPreview')?.parentElement?.parentElement?.closest('form');
   if(!form)return null;
   const f=form.elements;
   return {year:f.namedItem('year')?.value,make:f.namedItem('make')?.value,model:f.namedItem('model')?.value};
  })();
  if(!v?.make||!v?.model||v.make==='Other / not listed'||v.model==='Other / not listed')continue;
  const cached=modelPhotoCache[key];
  if(cached&&Date.now()-cached.checked<(cached.photo?PHOTO_CACHE_TTL:PHOTO_NEGATIVE_TTL)){
    applyModelPhotoToDom(key,cached.photo);continue;
  }
  if(modelPhotoRequests.has(key))continue;
  const request=queryCommonsPhotos(v).then(photo=>{
   modelPhotoCache[key]={photo,checked:Date.now()};
   try{const entries=Object.entries(modelPhotoCache).sort((a,b)=>b[1].checked-a[1].checked).slice(0,75);localStorage.setItem(PHOTO_CACHE_KEY,JSON.stringify(Object.fromEntries(entries)))}catch{}
   applyModelPhotoToDom(key,photo);
  }).catch(()=>{document.querySelectorAll('.vehiclePicture[data-pn-key]').forEach(node=>{if(node.dataset.pnKey===key)node.removeAttribute('data-pn-key')})}).finally(()=>modelPhotoRequests.delete(key));
  modelPhotoRequests.set(key,request);
 }
}

function save(){try{localStorage.setItem(STORE,JSON.stringify(db));if(typeof account!=='undefined'&&account.syncActive&&account.signedIn){const body=JSON.stringify(db);if(body.length<=700000)cloudBridge()?.saveCloud(body);else {account.syncActive=false;account.cloudMessage='Cloud sync paused: receipt photos are too large';}}return true}catch{notify('Storage is full. Export a backup or use smaller receipt photos.');return false}}
function notify(m){const n=$('toast');n.textContent=m;n.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>n.classList.remove('show'),4200)}
function go(p){page=p;render();window.scrollTo({top:0,behavior:'instant'})}
const nav=[['home','Dashboard','home'],['drive','Trips','drive'],['service','Maintenance','wrench'],['shops','Mechanics','map'],['more','More','more']];
function navigation(){ $('sideNav').innerHTML=nav.map(([key,label,ico])=>`<button class="sideItem ${page===key?'active':''}" data-page="${key}">${icon(ico)} ${label}</button>`).join('')+`<div class="sidebarFoot">Built for everyday drivers.<br>Cloud sync is optional.<br><br>Prototype v0.1.3 · PitNudge is a working name.</div>`; $('bottomNav').innerHTML=nav.map(([key,label,ico])=>`<button class="bottomItem ${page===key?'active':''}" data-page="${key}">${icon(ico,22)}<span>${label}</span></button>`).join('') }
function topVehicle(){const select=$('currentVehicle');select.innerHTML=db.vehicles.length?db.vehicles.map(v=>`<option value="${v.id}" ${v.id===db.selected?'selected':''}>${esc(v.year+' '+v.make+' '+v.model)}</option>`).join(''):'<option value="">No vehicles yet</option>';select.disabled=!db.vehicles.length}
function intro(kicker,title,description,action=''){return `<div class="pageIntro"><div><div class="eyebrow">${kicker}</div><h1>${title}</h1><p class="introText">${description}</p></div>${action}</div>`}
function noVehicle(){return `<div class="empty"><div style="font-size:45px">🚘</div><h2>Start with your vehicle</h2><p>Add your car or truck and its current odometer. We’ll build your maintenance dashboard around it.</p><button class="button" data-action="newVehicle">${icon('plus',17)} Add my vehicle</button></div>`}
function monthsAfter(d,n){let x=new Date(d+'T12:00:00');if(!Number.isFinite(+x))return null;let day=x.getDate();x.setDate(1);x.setMonth(x.getMonth()+n);let last=new Date(x.getFullYear(),x.getMonth()+1,0).getDate();x.setDate(Math.min(day,last));return x}
function serviceInfo(v,key){let config={...DEFAULTS[key],...(v.schedules?.[key]||{})};let last=db.records.filter(r=>r.vehicleId===v.id && r.kind==='service' && r.service===key).sort((a,b)=>b.date.localeCompare(a.date)||b.mileage-a.mileage)[0];if(!last)return {...config,key,status:'unknown',desc:'No service recorded — enter your last service to start reminders',remaining:null,progress:0};let dueAt=Number(last.mileage)+Number(config.miles);let remain=dueAt-Number(v.mileage);let dateDue=monthsAfter(last.date,Number(config.months));let daysLeft=dateDue?Math.ceil((dateDue.getTime()-Date.now())/86400000):null;let status=remain<=0||(daysLeft!==null&&daysLeft<=0)?'due':remain<=Math.max(500,config.miles*.10)||(daysLeft!==null&&daysLeft<=30)?'soon':'good';let description=status==='due'?'Service is due or overdue':`${miles(Math.max(0,remain))} mi remaining${daysLeft===null?'':` · due ${dateDue.toLocaleDateString('en-US',{month:'short',year:'numeric'})}`}`;return {...config,key,status,desc:description,remaining:remain,progress:Math.min(100,Math.max(0,100-remain/config.miles*100)),last,dueAt,dateDue,daysLeft};}
const statusLabel={due:'Due now',soon:'Due soon',good:'On track',unknown:'Set up'};
const severity={due:0,soon:1,unknown:2,good:3};
function serviceTile(s,mini=false){return `<div class="serviceItem"><div style="display:flex;align-items:flex-start;gap:11px;min-width:0"><div class="itemIcon">${icon(s.icon)}</div><div><div class="serviceTitle">${esc(s.name)}</div><div class="serviceMeta">${esc(s.desc)}</div>${mini?'':`<div class="mini">Schedule: ${miles(s.miles)} mi or ${s.months} months · whichever comes first</div>`}</div></div><div class="serviceInfo"><span class="status ${s.status}">${statusLabel[s.status]}</span><button class="button sm secondary" data-action="service" data-service="${s.key}">${s.status==='unknown'?'Set up':'Log'}</button>${mini?'':`<button class="button sm ghost" title="Edit interval" aria-label="Edit ${esc(s.name)} interval" data-action="interval" data-service="${s.key}">${icon('edit',14)}</button>`}</div></div>`}
function home(){let v=vehicle();if(!v)return intro('Welcome to PitNudge','Take care of your ride','Your personal maintenance companion.')+noVehicle();let stats=Object.keys(DEFAULTS).map(k=>serviceInfo(v,k)).sort((a,b)=>severity[a.status]-severity[b.status]);let urgent=stats.filter(x=>x.status==='due'||x.status==='soon').length;let total=db.records.filter(r=>r.vehicleId===v.id).reduce((s,r)=>s+Number(r.amount||0),0);let distance=db.trips.filter(t=>t.vehicleId===v.id).reduce((s,t)=>s+Number(t.miles||0),0);return intro('My garage','Your dashboard','Stay ahead of maintenance and keep all your vehicle records together.',`<button class="button sm secondary" data-action="newVehicle">${icon('plus',15)} Add vehicle</button>`)+`<div class="stack"><div class="panel hero"><div class="heroRow"><div><div class="heroLabel">${esc(vehicleName(v))}</div><div class="heroCount metric">${miles(v.mileage)} <span style="font-size:15px;letter-spacing:0">mi</span></div><div class="muted small" style="margin-top:7px">Estimated odometer · manually correct anytime</div></div>${vehiclePicture(v,'hero')}</div><div class="actions space"><button class="button sm" data-action="editVehicle">${icon('edit',16)} Update odometer</button><button class="button sm secondary" data-page="drive">${icon('drive',16)} Track a trip</button></div></div><div class="grid3"><div class="panel"><div class="statLabel">Needs attention</div><div class="statNum ${urgent?'amber':'green'}">${urgent}</div><div class="mini">Upcoming or due</div></div><div class="panel"><div class="statLabel">Logged miles</div><div class="statNum">${miles(distance)}</div><div class="mini">Across your trips</div></div><div class="panel"><div class="statLabel">Recorded costs</div><div class="statNum smallnum">${money(total)}</div><div class="mini">All saved expenses</div></div></div><section class="panel"><div class="panelHead"><h2>Maintenance overview</h2><button class="button sm ghost" data-page="service">See all ${icon('arrow',15)}</button></div>${stats.slice(0,4).map(s=>serviceTile(s,true)).join('')}</section><div class="grid2"><div class="panel"><div class="panelHead"><h2>Need a mechanic?</h2>${icon('pin')}</div><p class="muted small">Find local oil-change shops, tire shops, and repair professionals.</p><button class="button secondary" data-page="shops">Find nearby shops ${icon('arrow',16)}</button></div><div class="panel"><div class="panelHead"><h2>Keep your receipts</h2>${icon('receipt')}</div><p class="muted small">Save service details and a photo of each receipt on this device.</p><button class="button secondary" data-action="service">Log a service ${icon('arrow',16)}</button></div></div></div>`}
function drive(){let v=vehicle();if(!v)return intro('Mileage','Track your trips','Track personal and work driving.')+noVehicle();let trips=db.trips.filter(t=>t.vehicleId===v.id).sort((a,b)=>b.date.localeCompare(a.date));const business=trips.filter(t=>t.type==='business').reduce((a,t)=>a+Number(t.miles),0);const personal=trips.filter(t=>t.type!=='business').reduce((a,t)=>a+Number(t.miles),0);return intro('Mileage','Drive tracker','GPS tracking works while PitNudge is open. Background tracking is coming later.',`<button class="button sm secondary" data-action="trip">${icon('plus',16)} Add trip</button>`)+`<div class="stack"><section class="panel"><div class="labelRow"><h2>Trip detection</h2><span class="status ${activeTrip?'good':'unknown'}" id="tripStatus">${activeTrip?'Recording':'Not recording'}</span></div><p class="muted small" style="margin:10px 0 20px">${activeTrip?'Keep PitNudge open while driving. Distance updates when accurate GPS readings arrive.':'Enable automatic detection to watch for driving while the app is open, or start a trip manually.'}</p><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap"><label class="toggle"><input type="checkbox" id="autoDetect" ${db.autoDetect?'checked':''}/> Auto-detect driving while open</label><span class="topTip">${icon('pin',14)} Location permission required</span></div><div class="resultCard space"><div><div class="statLabel">Current trip</div><div class="valueLarge metric" id="liveMiles">${activeTrip?miles(activeTrip.miles):'0'} <span style="font-size:14px">mi</span></div><div class="small muted" id="liveKind">${activeTrip?`Recording for ${esc(vehicleName(db.vehicles.find(x=>x.id===activeTrip.vehicleId)))}`:'No trip in progress'}</div></div><div>${icon('drive',38)}</div></div><div class="actions space"><button class="button" data-action="${activeTrip?'stopTrip':'startTrip'}">${icon(activeTrip?'check':'drive',18)} ${activeTrip?'Finish trip':'Start GPS trip'}</button>${activeTrip?'<button class="button ghost" data-action="cancelTrip">Discard trip</button>':''}</div>${activeTrip?`<div class="space"><label class="field">Trip category<select id="liveCategory"><option value="personal" ${activeTrip.type==='personal'?'selected':''}>Personal</option><option value="business" ${activeTrip.type==='business'?'selected':''}>Business (DoorDash, work, etc.)</option></select></label></div>`:''}</section><div class="note"><strong>About automatic tracking:</strong> This browser version cannot reliably track when your phone is locked or the app is closed. The future Android version will need approved background location access. GPS miles are estimates; periodically check against your odometer.</div><div class="grid2"><div class="panel"><div class="statLabel">Business miles logged</div><div class="statNum metric">${miles(business)}</div></div><div class="panel"><div class="statLabel">Personal miles logged</div><div class="statNum metric">${miles(personal)}</div></div></div><section class="panel"><div class="panelHead"><h2>Recent trips</h2><button class="button sm ghost" data-action="trip">${icon('plus',14)} Manual trip</button></div>${trips.length?trips.slice(0,15).map(t=>`<div class="record"><div><div style="font-weight:750">${miles(t.miles)} miles <span class="chip">${t.type==='business'?'Business':'Personal'}</span></div><div class="small muted">${humanDate(t.date)} · ${t.source==='gps'?'GPS estimate':'Manual entry'}${t.note?' · '+esc(t.note):''}</div></div><div class="actions"><button class="button sm secondary" data-action="editTrip" data-id="${t.id}">Edit</button><button class="button sm ghost" data-action="deleteTrip" data-id="${t.id}" aria-label="Delete trip">${icon('trash',16)}</button></div></div>`).join(''):'<div class="empty"><p>No trips recorded yet. Start GPS tracking or add