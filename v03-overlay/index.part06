ype="file" name="photo" accept="image/*" capture="environment" /></label><label class="field wide">Notes / shop name<textarea name="note" maxlength="400" placeholder="Where you went or what you replaced"></textarea></label></div><p class="small muted">Photos are compressed and stored locally. For old services, enter the actual service mileage and date.</p><button class="button space" type="submit">Save service & receipt</button></form>`,async (f,form)=>{let img=await photoData(form.querySelector('[name=photo]').files[0]);db.records.push({id:id(),vehicleId:v.id,kind:'service',service:f.get('service'),date:String(f.get('date')),mileage:Number(f.get('mileage')),amount:Number(f.get('amount')||0),note:String(f.get('note')||''),photo:img});if(!save()){db.records.pop();return false}notify('Service saved. Maintenance reminders updated.')})}
function intervalDialog(key){let v=vehicle(),s=serviceInfo(v,key);showModal('Customize '+s.name,`<form><div class="formGrid">${field('Every ___ miles','miles',true,'number',s.miles,'min="100" max="150000" step="100"')}${field('Or every ___ months','months',true,'number',s.months,'min="1" max="120" step="1"')}</div><p class="small muted">The next reminder is based on whichever interval comes first. Check your owner's manual for vehicle-specific intervals.</p><button type="submit" class="button space">Save schedule</button></form>`,f=>{v.schedules=v.schedules||{};v.schedules[key]={miles:Number(f.get('miles')),months:Number(f.get('months'))};save();notify('Schedule updated.')})}
function manualTripDialog(){let v=vehicle();if(!v){notify('Add a vehicle first.');return}showModal('Add a trip',`<form><div class="formGrid">${field('Date','date',true,'date',today())}${field('Distance (miles)','miles',true,'number','','min="0.1" max="10000" step="0.1"')}<label class="field wide">Trip purpose<select name="type"><option value="personal">Personal</option><option value="business">Business (work / deliveries)</option></select></label><label class="field wide">Purpose or notes<textarea name="note" maxlength="400" placeholder="Example: Delivery shift, errands, commute"></textarea></label></div><p class="small muted">This trip will also add miles to the selected vehicle's estimated odometer. Don't add trips already included in your odometer reading.</p><button class="button space" type="submit">Save trip</button></form>`,f=>{let m=Number(f.get('miles'));if(!Number.isFinite(m)||m<=0){notify('Enter a valid distance.');return false}db.trips.push({id:id(),vehicleId:v.id,date:String(f.get('date')),miles:m,type:String(f.get('type')),note:String(f.get('note')||''),source:'manual'});v.mileage=Number((Number(v.mileage)+m).toFixed(1));save();notify('Trip added and odometer estimate updated.')})}
function editTripDialog(tripId){let t=db.trips.find(x=>x.id===tripId);if(!t)return;showModal('Edit recorded trip',`<form><div class="formGrid">${field('Trip date','date',true,'date',t.date)}${field('Distance (miles)','miles',true,'number',t.miles,'min="0.1" max="10000" step="0.1"')}<label class="field wide">Trip category<select name="type"><option value="personal" ${t.type==='personal'?'selected':''}>Personal</option><option value="business" ${t.type==='business'?'selected':''}>Business</option></select></label><label class="field wide">Business purpose / notes<textarea name="note" maxlength="400" placeholder="Example: Delivery shift, client visit">${esc(t.note||'')}</textarea></label></div><p class="small muted">Editing the distance also adjusts the vehicle’s estimated odometer by the difference.</p><button class="button space" type="submit">Update trip</button></form>`,f=>{const revised=Number(f.get('miles'));if(!Number.isFinite(revised)||revised<=0)return false;let v=db.vehicles.find(v=>v.id===t.vehicleId);if(v)v.mileage=Math.max(0,Math.round((Number(v.mileage)+revised-Number(t.miles))*10)/10);Object.assign(t,{date:String(f.get('date')),miles:revised,type:String(f.get('type')),note:String(f.get('note')||'')});save();notify('Trip updated.')})}
function expenseDialog(){let v=vehicle();if(!v){notify('Add a vehicle first.');return}showModal('Add vehicle expense',`<form><div class="formGrid"><label class="field wide">Expense type<select name="category"><option>Fuel</option><option>Parking</option><option>Tolls</option><option>Car wash</option><option>Parts / supplies</option><option>Insurance</option><option>Other</option></select></label>${field('Date','date',true,'date',today())}${field('Cost ($)','amount',true,'number','','min="0" step="0.01"')}${field('Odometer (miles)','mileage',true,'number',v.mileage,'min="0" step="0.1"')}<label class="field">Receipt photo<input name="photo" type="file" accept="image/*" capture="environment"/></label><label class="field wide">Notes<textarea name="note" maxlength="400"></textarea></label></div><p class="small muted">Recording a vehicle cost does not mean the cost qualifies as a tax deduction.</p><button class="button space" type="submit">Save expense</button></form>`,async (f,form)=>{let img=await photoData(form.querySelector('[name=photo]').files[0]);db.records.push({id:id(),vehicleId:v.id,kind:'expense',category:String(f.get('category')),date:String(f.get('date')),mileage:Number(f.get('mileage')),amount:Number(f.get('amount')),note:String(f.get('note')||''),photo:img});if(!save()){db.records.pop();return false}notify('Expense saved.')})}
async function photoData(file){if(!file)return '';if(!file.type.startsWith('image/'))throw Error('Choose an image file.');if(file.size>20*1024*1024)throw Error('This photo is too large. Use a smaller image.');return new Promise((resolve,reject)=>{let pic=new Image(),url=URL.createObjectURL(file);pic.onload=()=>{try{let max=650,scale=Math.min(1,max/Math.max(pic.width,pic.height)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(pic.width*scale));canvas.height=Math.max(1,Math.round(pic.height*scale));canvas.getContext('2d').drawImage(pic,0,0,canvas.width,canvas.height);let data=canvas.toDataURL('image/jpeg',.58);URL.revokeObjectURL(url);resolve(data)}catch(e){reject(e)}};pic.onerror=()=>{URL.revokeObjectURL(url);reject(Error('Photo could not be read.'))};pic.src=url})}
function download(filename,contents,mime='text/plain;charset=utf-8'){if(window.NativePitNudge&&typeof window.NativePitNudge.saveFile==='function'){window.NativePitNudge.saveFile(filename,contents,mime);notify('Saving '+filename+' to Downloads.');return}let b=new Blob([contents],{type:mime}),url=URL.createObjectURL(b),a=document.createElement('a');a.href=url;a.download=filename;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500)}
const csvCell=v=>'"'+String(v??'').replace(/"/g,'""')+'"';
const csv=(rows)=>rows.map(row=>row.map(csvCell).join(',')).join('\r\n');
function exportTrips(){let rows=[['Date','Vehicle','Type','Miles','Source','Purpose / notes'],...db.trips.map(t=>[t.date,vehicleName(db.vehicles.find(v=>v.id===t.vehicleId)),t.type,t.miles,t.source,t.note])];download('PitNudge-trips.csv',csv(rows),'text/csv;charset=utf-8')}
function exportCosts(){let rows=[['Date','Vehicle','Category','Mileage','Amount USD','Notes','Has receipt photo'],...db.records.map(r=>[r.date,vehicleName(db.vehicles.find(v=>v.id===r.vehicleId)),r.kind==='service'?(DEFAULTS[r.service]?.name||'Other service'):r.category,r.mileage,r.amount,r.note,r.photo?'Yes':'No'])];download('PitNudge-costs.csv',csv(rows),'text/csv;charset=utf-8')}
function confirmAction(message){return window.confirm(message)}
function startWatch(){if(!('geolocation' in navigator)){notify('GPS is unavailable in this browser. You can still enter trips manually.');return false}if(watchId!==null)return true;monitorError=false;try{watchId=navigator.geolocation.watchPosition(onPosition,err=>{if(!monitorError){notify('Location unavailable: '+err.message+'. Check Android location permission.');monitorError=true}if(err.code===1){db.autoDetect=false;save();if(watchId!==null)navigator.geolocation.clearWatch(watchId);watchId=null;render()}},{enableHighAccuracy:true,maximumAge:4000,timeout:25000});return true}catch(e){notify('Could not enable GPS: '+e.message);return false}}
function stopWatchIfUnused(){if(!db.autoDetect&&!activeTrip&&watchId!==null){navigator.geolocation.clearWatch(watchId);watchId=null;lastFix=null;movingSamples=0}}
const rad=x=>x*Math.PI/180;
function haversine(a,b){const R=3958.7613,dl=rad(b.lat-a.lat),dn=rad(b.lon-a.lon),q=Math.sin(dl/2)**2+Math.cos(rad(a.lat))*Math.cos(rad(b.lat))*Math.sin(dn/2)**2;return 2*R*Math.asin(Math.min(1,Math.sqrt(q)))}
function onPosition(position){const c=position.coords,t=position.timestamp||Date.now();if(!Number.isFinite(c.latitude)||!Number.isFinite(c.longitude)||(Number.isFinite(c.accuracy)&&c.accuracy>90))return;let p={lat:c.latitude,lon:c.longitude,time:t};let d=lastFix?haversine(lastFix,p):0,seconds=lastFix?(t-lastFix.time)/1000:0;let mph=Number.isFinite(c.speed)&&c.speed>=0?c.speed*2.23694:seconds>4?d/seconds*3600:0;let valid=!!lastFix&&seconds>=2&&seconds<180&&mph<115&&d<3.5;let moving=valid&&(mph>=5||d>=.015);if(moving){movingSamples++;lastMovingAt=t}else if(valid)movingSamples=0;
if(db.autoDetect&&!activeTrip&&movingSamples>=2){activeTrip={vehicleId:db.selected,startedAt:new Date(t).toISOString(),miles:0,type:'personal',source:'gps',automatic:true};notify('Driving detected! Trip recording started.');render()}
if(activeTrip&&valid&&moving&&activeTrip.vehicleId===db.selected){activeTrip.miles+=d;activeTrip.miles=Math.round(activeTrip.miles*1000)/1000;let el=$('liveMiles');if(el)el.innerHTML=miles(activeTrip.miles)+' <span style="font-size:14px">mi</span>'}
if(activeTrip?.automatic&&lastMovingAt&&t-lastMovingAt>180000&&activeTrip.miles>.2){finishTrip(true)}
lastFix=p}
function startTrip(){let v=vehicle();if(!v){notify('Add a vehicle first.');return}if(activeTrip)return;let ok=startWatch();if(!ok)return;activeTrip={vehicleId:v.id,startedAt:new Date().toISOString(),miles:0,type:'personal',source:'gps',automatic:false};lastFix=null;movingSamples=0;render();notify('GPS trip started. Keep PitNudge open and location access enabled.')}
function finishTrip(auto=false){if(!activeTrip)return;let trip=activeTrip;activeTrip=null;lastFix=null;movingSamples=0;let mi=Math.round(trip.miles*10)/10;if(mi>=.1){let v=db.vehicles.find(v=>v.id===trip.vehicleId);db.trips.push({id:id(),vehicleId:trip.vehicleId,date:trip.startedAt.slice(0,10),miles:mi,type:trip.type,source:'gps',note:auto?'Automatically detected trip':''});if(v)v.mileage=Math.round((Number(v.mileage)+mi)*10)/10;save();notify(`${miles(mi)} miles saved to your ${trip.type} trip log.`)}else notify('Trip was too short to save. GPS may not have tracked enough distance.');stopWatchIfUnused();render()}
function toggleAuto(checked){db.autoDetect=checked;save();if(checked){if(!startWatch()){db.autoDetect=false;save()}}else stopWatchIfUnused();render();if(checked)notify('Auto-detect enabled while PitNudge is open.')}
function diy(){showModal('DIY maintenance basics',`<div class="stack"><div><h3>Oil and filters</h3><p class="muted small">Check the owner’s manual for oil type, capacity, service interval, and filter location. Record the mileage and date after service.</p></div><div><h3>Tires</h3><p class="muted small">Check pressure against the vehicle door-jamb label when tires are cold. Monitor tread and wear; follow your vehicle’s tire-rotation pattern.</p></div><div><h3>Brakes and safety</h3><p class="muted small">Squealing, grinding, pulling, or a soft brake pedal deserve professional inspection. Brake repairs are safety-critical; do not drive if braking is unsafe.</p></div><div><h3>Before any DIY repair</h3><p class="muted small">Use the correct tools, stable lifting equipment, and model-specific repair guidance. Never work under a car supported only by a jack.</p></div><button class="button" type="button" id="diyClose">Got it</button></div>`,()=>{});$('diyClose').onclick=()=>$('modal').close()}
// One delegate covers content, sidebar, and bottom navigation.
document.addEventListener('click',e=>{let b=e.target.closest('[data-page],[data-more],[data-action]');if(!b)return;if(b.dataset.page){if(activeTrip&&b.dataset.page==='more'){}go(b.dataset.page);return}if(b.dataset.more){moreTab=b.dataset.more;go('more');return}let a=b.dataset.action;if(['googleLogin','appleLogin','accountLogout','cloudSave','cloudRestore'].includes(a)){accountAction(a);return}if(a==='newVehicle')vehicleDialog();if(a==='editVehicle')vehicleDialog(b.dataset.id||db.selected);if(a==='chooseVehicle'){if(activeTrip){notify('Finish the active trip before switching vehicles.');return}db.selected=b.dataset.id;save();render()}if(a==='deleteVehicle'){let v=db.vehicles.find(v=>v.id===b.dataset.id);if(!v||!confirmAction(`Remove ${vehicleName(v)} and all its trips and service records? This cannot be undone.`))return;if(activeTrip?.vehicleId===v.id){notify('Finish your trip before removing this vehicle.');return}db.vehicles=db.vehicles.filter(x=>x.id!==v.id);db.records=db.records.filter(x=>x.vehicleId!==v.id);db.trips=db.trips.filter(x=>x.vehicleId!==v.id);db.selected=db.vehicles[0]?.id||null;save();render()}if(a==='service')serviceDialog(b.dataset.service);if(a==='interval')intervalDialog(b.dataset.service);if(a==='trip')manualTripDialog();if(a==='editTrip')editTripDialog(b.dataset.id);if(a==='expense')expenseDialog();if(a==='deleteTrip'){if(confirmAction('Remove this trip? Its mileage will be subtracted from your estimated odometer.')){let t=db.trips.find(x=>x.id===b.dataset.id),v=db.vehicles.find(x=>x.id===t?.vehicleId);if(t&&v)v.mileage=Math.max(0,Number((v.mileage-Number(t.miles)).toFixed(1)));db.trips=db.trips.filter(t=>t.id!==b.dataset.id);save();render()}}if(a==='deleteRecord'){if(confirmAction('Delete this service or expense record?')){db.records=db.records.filter(r=>r.id!==b.dataset.id);save();render()}}if(a==='startTrip')startTrip();if(a==='stopTrip')finishTrip();if(a==='cancelTrip'&&confirmAction('Discard this trip without saving miles?')){activeTr