d while driving (Android GPS)':'Tracked with Android GPS',route};
     db.trips.push(trip);
     v.mileage=Math.round((Number(v.mileage)+trip.miles)*10)/10;
     if(save()){window.NativePitNudge.ackMileageEvent(e.id);changed=true;newSaved+=trip.miles}
     else{db.trips.pop();v.mileage=Math.round((Number(v.mileage)-trip.miles)*10)/10}
   }else if(!v){
     // Preserve events if a matching car is temporarily missing during cloud restore.
     console.warn('PitNudge trip awaiting vehicle restore');
   }else window.NativePitNudge.ackMileageEvent(e.id);
 }
 let wasRunning=!!old.running, wasRecording=!!old.recording, oldVehicle=old.vehicleId;
 nativeMileageState=next;
 if(next.running)nativeMileageStarting=false;
 if(next.running&&next.recording){
   activeTrip={native:true,vehicleId:next.vehicleId,startedAt:next.startedAt||new Date().toISOString(),miles:Number(next.miles)||0,type:next.category==='business'?'business':'personal',source:'gps',automatic:next.mode==='auto',route:normalRoute(next.route)};
 }else activeTrip=null;
 if(!next.running&&wasRunning&&db.autoDetect){db.autoDetect=false;save()}
 if(newSaved>0)notify(miles(newSaved)+' GPS miles saved to your estimated odometer.');
 if(changed||wasRunning!==!!next.running||wasRecording!==!!next.recording||oldVehicle!==next.vehicleId){render();updateLiveRouteMap();return}
 const live=$('liveMiles');if(live)live.innerHTML=miles(activeTrip?.miles||0)+' <span style="font-size:14px">mi</span>';
 const desc=$('liveKind');if(desc && next.running)desc.textContent=next.recording?'Recording GPS miles':next.message||'Watching for driving';
 updateLiveRouteMap();
}
function startNativeMileage(mode){
 const v=vehicle();if(!v){notify('Add a vehicle first.');return false}
 if(nativeMileageState.running){notify('GPS mileage tracking is already running.');return false}
 nativeMileageStarting=true;
 window.NativePitNudge.startMileage(v.id,mode,'personal',!!db.saveRouteMaps);
 setTimeout(refreshNativeMileage,1200);
 if(page==='drive')render();
 notify(mode==='auto'?'Watching for driving: GPS monitoring will remain active with the screen locked.':'GPS trip requested. Allow location and notification access when prompted.');
 return true;
}
function startWatch(){if(!('geolocation' in navigator)){notify('GPS is unavailable in this browser. You can still enter trips manually.');return false}if(watchId!==null)return true;monitorError=false;try{watchId=navigator.geolocation.watchPosition(onPosition,err=>{if(!monitorError){notify('Location unavailable: '+err.message+'. Check Android location permission.');monitorError=true}if(err.code===1){db.autoDetect=false;save();if(watchId!==null)navigator.geolocation.clearWatch(watchId);watchId=null;render()}},{enableHighAccuracy:true,maximumAge:4000,timeout:25000});return true}catch(e){notify('Could not enable GPS: '+e.message);return false}}
function stopWatchIfUnused(){if(!db.autoDetect&&!activeTrip&&watchId!==null){navigator.geolocation.clearWatch(watchId);watchId=null;lastFix=null;movingSamples=0}}
const rad=x=>x*Math.PI/180;
function haversine(a,b){const R=3958.7613,dl=rad(b.lat-a.lat),dn=rad(b.lon-a.lon),q=Math.sin(dl/2)**2+Math.cos(rad(a.lat))*Math.cos(rad(b.lat))*Math.sin(dn/2)**2;return 2*R*Math.asin(Math.min(1,Math.sqrt(q)))}
function onPosition(position){const c=position.coords,t=position.timestamp||Date.now();if(!Number.isFinite(c.latitude)||!Number.isFinite(c.longitude)||(Number.isFinite(c.accuracy)&&c.accuracy>90))return;let p={lat:c.latitude,lon:c.longitude,time:t};let d=lastFix?haversine(lastFix,p):0,seconds=lastFix?(t-lastFix.time)/1000:0;let mph=Number.isFinite(c.speed)&&c.speed>=0?c.speed*2.23694:seconds>4?d/seconds*3600:0;let valid=!!lastFix&&seconds>=2&&seconds<180&&mph<115&&d<3.5;let moving=valid&&(mph>=5||d>=.015);if(moving){movingSamples++;lastMovingAt=t}else if(valid)movingSamples=0;
if(db.autoDetect&&!activeTrip&&movingSamples>=2){activeTrip={vehicleId:db.selected,startedAt:new Date(t).toISOString(),miles:0,type:'personal',source:'gps',automatic:true,route:db.saveRouteMaps&&lastFix?[[lastFix.lat,lastFix.lon]]:[]};notify('Driving detected! Trip recording started.');render()}
if(activeTrip&&valid&&moving&&activeTrip.vehicleId===db.selected){if(db.saveRouteMaps){if(!Array.isArray(activeTrip.route))activeTrip.route=[];activeTrip.route.push([Math.round(p.lat*100000)/100000,Math.round(p.lon*100000)/100000]);activeTrip.route=downsampleRoute(activeTrip.route)}activeTrip.miles+=d;activeTrip.miles=Math.round(activeTrip.miles*1000)/1000;let el=$('liveMiles');if(el)el.innerHTML=miles(activeTrip.miles)+' <span style="font-size:14px">mi</span>'}
if(activeTrip?.automatic&&lastMovingAt&&t-lastMovingAt>180000&&activeTrip.miles>.2){finishTrip(true)}
lastFix=p}
function startTrip(){if(nativeMileageAvailable()){if(nativeMileageState.running){window.NativePitNudge.stopMileage();nativeMileageStarting=false;setTimeout(refreshNativeMileage,1200);notify('Stopping GPS monitoring.');return}startNativeMileage('manual');return}let v=vehicle();if(!v){notify('Add a vehicle first.');return}if(activeTrip)return;let ok=startWatch();if(!ok)return;activeTrip={vehicleId:v.id,startedAt:new Date().toISOString(),miles:0,type:'personal',source:'gps',automatic:false,route:[]};lastFix=null;movingSamples=0;render();notify('GPS trip started. Keep PitNudge open and location access enabled.')}
function finishTrip(auto=false){if(nativeMileageAvailable()&&nativeMileageState.running){window.NativePitNudge.stopMileage();nativeMileageStarting=false;notify('Finishing GPS trip. The odometer will update after it is saved.');setTimeout(refreshNativeMileage,1000);setTimeout(refreshNativeMileage,2200);return}if(!activeTrip)return;let trip=activeTrip;activeTrip=null;lastFix=null;movingSamples=0;let mi=Math.round(trip.miles*10)/10;if(mi>=.1){let v=db.vehicles.find(v=>v.id===trip.vehicleId);db.trips.push({id:id(),vehicleId:trip.vehicleId,date:trip.startedAt.slice(0,10),miles:mi,type:trip.type,source:'gps',note:auto?'Automatically detected trip':'',route:normalRoute(trip.route)});if(v)v.mileage=Math.round((Number(v.mileage)+mi)*10)/10;save();notify(`${miles(mi)} miles saved to your ${trip.type} trip log.`)}else notify('Trip was too short to save. GPS may not have tracked enough distance.');stopWatchIfUnused();render()}
function toggleAuto(checked){if(nativeMileageAvailable()){if(checked && !nativeMileageState.running){db.autoDetect=true;save();if(!startNativeMileage('auto')){db.autoDetect=false;save()}return}if(!checked && nativeMileageState.running){db.autoDetect=false;save();window.NativePitNudge.stopMileage();nativeMileageStarting=false;notify('GPS monitoring is stopping.');setTimeout(refreshNativeMileage,1000);render();return}db.autoDetect=checked;save();render();return}db.autoDetect=checked;save();if(checked){if(!startWatch()){db.autoDetect=false;save()}}else stopWatchIfUnused();render();if(checked)notify('Auto-detect enabled while PitNudge is open.')}
function diy(){showModal('DIY maintenance basics',`<div class="stack"><div><h3>Oil and filters</h3><p class="muted small">Check the owner’s manual for oil type, capacity, service interval, and filter location. Record the mileage and date after service.</p></div><div><h3>Tires</h3><p class="muted small">Check pressure against the vehicle door-jamb label when tires are cold. Monitor tread and wear; follow your vehicle’s tire-rotation pattern.</p></div><div><h3>Brakes and safety</h3><p class="muted small">Squealing, grinding, pulling, or a soft brake pedal deserve professional inspection. Brake repairs are safety-critical; do not drive if braking is unsafe.</p></div><div><h3>Before any DIY repair</h3><p class="muted small">Use the correct tools, stable lifting equipment, and model-specific repair guidance. Never work under a car supported only by a jack.</p></div><button class="button" type="button" id="diyClose">Got it</button></div>`,()=>{});$('diyClose').onclick=()=>$('modal').close()}
// One delegate covers content, sidebar, and bottom navigation.
document.addEventListener('click',e=>{let b=e.target.closest('[data-page],[data-more],[data-action]');if(!b)return;if(b.dataset.page){if(activeTrip&&b.dataset.page==='more'){}go(b.dataset.page);return}if(b.dataset.more){moreTab=b.dataset.more;go('more');return}let a=b.dataset.action;if(['googleLogin','appleLogin','accountLogout','cloudSave','cloudRestore'].includes(a)){accountAction(a);return}if(a==='newVehicle')vehicleDialog();if(a==='editVehicle')vehicleDialog(b.dataset.id||db.selected);if(a==='chooseVehicle'){if(activeTrip){notify('Finish the active trip before switching vehicles.');return}db.selected=b.dataset.id;save();render()}if(a==='deleteVehicle'){let v=db.vehicles.find(v=>v.id===b.dataset.id);if(!v||!confirmAction(`Remove ${vehicleName(v)} and all its trips and service records? This cannot be undone.`))return;if(activeTrip?.vehicleId===v.id){notify('Finish your trip before removing this vehicle.');return}db.vehicles=db.vehicles.filter(x=>x.id!==v.id);db.records=db.records.filter(x=>x.vehicleId!==v.id);db.trips=db.trips.filter(x=>x.vehicleId!==v.id);db.selected=db.vehicles[0]?.id||null;save();render()}if(a==='service')serviceDialog(b.dataset.service);if(a==='interval')intervalDialog(b.dataset.service);if(a==='trip')manualTripDialog();if(a==='editTrip'){$('modal')?.close();editTripDialog(b.dataset.id);}if(a==='viewTripRoute')showRouteMap(b.dataset.id);if(a==='viewLiveRoute')showRouteMap(null);if(a==='removeTripRoute')removeTripRoute(b.dataset.id);if(a==='expense')expenseDialog();if(a==='deleteTrip'){if(confirmAction('Remove this trip? Its mileage will be subtracted from your estimated odometer.')){let t=db.trips.find(x=>x.id===b.dataset.id),v=db.vehicles.find(x=>x.id===t?.vehicleId);if(t&&v)v.mileage=Math.max(0,Number((v.mileage-Number(t.miles)).toFixed(1)));db.trips=db.trips.filter(t=>t.id!==b.dataset.id);save();render()}}if(a==='deleteRecord'){if(confirmAction('Delete this service or expense record?')){db.records=db.records.filter(r=>r.id!==b.dataset.id);save();render()}}if(a==='startTrip')startTrip();if(a==='stopTrip')finishTrip();if(a==='cancelTrip'&&confirmAction('Discard this trip without saving miles?')){if(nativeMileageAvailable()&&nativeMileageState.running){window.NativePitNudge.discardMileage();setTimeout(refreshNativeMileage,1000);notify('Trip discarded.')}else{activeTrip=null;stopWatchIfUnused();render()}}if(a==='diy')diy();if(a==='exportTrips')exportTrips();if(a==='exportCosts')exportCosts();if(a==='backup')download('PitNudge-backup.json',JSON.stringify(db,null,2),'application/json');if(a==='import')$('importFile')?.click();if(a==='reset'&&confirmAction('Erase ALL PitNudge data saved in this browser? This cannot be undone unless you have a backup.')){if(activeTrip){activeTrip=null}if(watchId!==null){navigator.geolocation.clearWatch(watchId);watchId=null}db=blank();save();page='home';render();notify('Local data deleted.')}});
document.addEventListener('change',async e=>{if(e.target.id==='currentVehicle'){if(activeTrip){notify('Finish your active trip before changing vehicles.');render();return}db.selected=e.target.value;save();render()}if(e.target.id==='autoDetect'||e.target.id==='autoDetectSettings')toggleAuto(e.target.checked);if(e.target.id==='saveRouteMaps'){db.saveRouteMaps=!!e.target.checked;save();if(nativeMileageAvailable()&&nativeMileageState.running){window.NativePitNudge.setMileageRoute(db.saveRouteMaps);notify(db.saveRouteMaps?'Route recording enabled for the remainder of this monitoring session.':'Route recording stopped.');}else notify(db.saveRouteMaps?'New GPS trips will save a map.':'Future trips will only save mileage.');}if(e.target.id==='liveCategory'&&activeTrip){activeTrip.type=e.target.value;if(activeTrip.native)window.NativePitNudge.setMileageCategory(e.target.value)}if(e.target.id==='importFile'){let f=e.target.files[0];if(!f)return;try{let data=JSON.parse(await f.text());if(!Array.isArray(data.vehicles)||!Array.isArray(data.records)||!Array.isArray(data.trips))throw Error('Invalid PitNudge backup format');if(!confirmAction('Restore this backup? Your current data will be replaced.'))return;if(watchId!==null){navigator.geolocation.clearWatch(watchId);watchId=null}activeTrip=null;db={...blank(),...data,autoDetect:false};save();moreTab='garage';render();notify('Backup restored!')}catch(err){notify(err.message||'Could not import backup.')}e.target.value=''}});
$('closeModal').addEventListener('click',()=>$('modal').close());
$('modal').addEventListener('close',()=>{liveRouteModal=false;if(routeMapInstance){routeMapInstance.remove();routeMapInstance=null;routeMapLine=null;routeMapEndMarker=null}});
window.addEventListener('beforeunload',e=>{if(activeTrip&&!activeTrip.native){e.preventDefault();e.returnValue=''}});
render();
