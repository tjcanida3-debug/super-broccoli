w URL(url);return u.protocol==='https:'&&(u.hostname===host||u.hostname.endsWith('.'+host))}catch{return false}}
function photoLicenseIsAllowed(name){
 const n=String(name||'').trim();
 // Reusable for commercial apps with proper credits. Never include noncommercial or no-derivatives media.
 return /^CC0(?:\s+1\.0)?$/i.test(n)||/^Public domain$/i.test(n)||/^CC BY(?:-SA)?\s+(?:1\.0|2\.0|2\.5|3\.0|4\.0)$/i.test(n);
}
function photoMetaText(s){const t=document.createElement('span');t.innerHTML=String(s||'').replace(/<[^>]*>/g,' ');return t.textContent.replace(/\s+/g,' ').trim().slice(0,130)}
function currentModelPhoto(v){
 const e=modelPhotoCache[modelPhotoKey(v)];
 return e&&e.photo&&Date.now()-e.checked<PHOTO_CACHE_TTL?e.photo:null;
}
function modelPhotoCredit(photo){
 const who=photo.author?`Photo: ${esc(photo.author)} · `:'Photo: ';
 return `<div class="pictureCredit">${who}<a href="${esc(photo.page)}" target="_blank" rel="noopener noreferrer">source</a> · <a href="${esc(photo.licenseUrl)}" target="_blank" rel="noopener noreferrer">${esc(photo.license)}</a></div>`;
}
function vehiclePicture(v,context='garage'){
 const saved=typeof v?.photo==='string'&&/^data:image\/(?:jpeg|png|webp);base64,/i.test(v.photo);
 const key=modelPhotoKey(v);
 const model=(!saved&&v?.make&&v?.model)?currentModelPhoto(v):null;
 const image=saved?`<img src="${esc(v.photo)}" alt="Photo of ${esc(vehicleName(v))}"/>`
      :model?`<img src="${esc(model.url)}" alt="Example photo of ${esc(v.make)} ${esc(v.model)}; model year may differ" loading="lazy" referrerpolicy="no-referrer" />`
      :illustrationSvg(v||{});
 const label=saved?'Your photo':model?'Example model photo':vehicleBodyType(v)+' illustration';
 const credit=model?modelPhotoCredit(model):'';
 const pending=(!saved&&!model&&v?.make&&v?.model)?` data-pn-key="${esc(key)}"`:'';
 return `<div class="vehiclePicture ${context==='hero'?'heroPhoto':context==='form'?'formPhoto':'garagePhoto'}"${pending}>${image}<span class="imageType">${esc(label)}</span>${credit}</div>`;
}
function photoCandidate(p,make,model,year){
 const ii=(p.imageinfo||[])[0];
 if(!ii||!ii.thumburl||!photoUrlIsSafe(ii.thumburl,'wikimedia.org')||ii.width<450||ii.height<240)return null;
 if(!/\.(jpg|jpeg|png|webp)$/i.test(p.title||''))return null;
 const title=normalizePhotoWords((p.title||'').replace(/^File:/i,''));
 const wanted=normalizePhotoWords(make+' '+model).split(' ').filter(Boolean);
 if(!wanted.every(token=>title.split(' ').includes(token)))return null;
 if(/\b(interior|engine|wheel|tire|logo|badge|emblem|brochure|dashboard|instrument cluster|illustration|diagram|cutaway|parts|license plate|advertisement)\b/.test(title))return null;
 const meta=ii.extmetadata||{};
 const field=k=>meta[k]?.value||'';
 const license=photoMetaText(field('LicenseShortName'));
 if(!photoLicenseIsAllowed(license)||String(field('NonFree')).toLowerCase()==='true')return null;
 const licenseRaw=String(field('LicenseUrl')||'').replace(/^http:/i,'https:');
 const licenseUrl=photoUrlIsSafe(licenseRaw,'creativecommons.org')?licenseRaw:'https://commons.wikimedia.org/wiki/'+encodeURIComponent(p.title.replace(/ /g,'_'));
 const author=photoMetaText(field('Attribution')||field('Artist')||field('Credit'));
 if(!author&&!/^CC0|^Public domain$/i.test(license))return null;
 const page='https://commons.wikimedia.org/wiki/'+encodeURIComponent(p.title.replace(/ /g,'_'));
 const yearPresent=title.includes(String(year));
 // Do not claim exact year unless the actual file title identifies it.
 return {photo:{url:ii.thumburl,page,author,license,licenseUrl,yearVerified:yearPresent},score:(yearPresent?80:0)+Math.min(ii.width,1500)/150+Math.min(wanted.join(' ').length,35)};
}
async function queryCommonsPhotos(v){
 const make=String(v.make||'').trim(),model=String(v.model||'').trim(),year=String(v.year||'').trim();
 if(!make||!model)return null;
 const queries=[`${year} ${make} ${model}`,`${make} ${model}`];
 for(const query of queries){
  const params=new URLSearchParams({action:'query',format:'json',formatversion:'2',generator:'search',gsrsearch:query,gsrnamespace:'6',gsrlimit:'20',prop:'imageinfo',iiprop:'url|size|mime|extmetadata',iiurlwidth:'740',origin:'*'});
  const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),9000);
  let result;
  try{const response=await fetch('https://commons.wikimedia.org/w/api.php?'+params.toString(),{signal:ctrl.signal,mode:'cors'});if(!response.ok)throw Error('Media service unavailable');result=await response.json()}
  finally{clearTimeout(timer)}
  const candidates=(result?.query?.pages||[]).map(p=>photoCandidate(p,make,model,year)).filter(Boolean).sort((a,b)=>b.score-a.score);
  if(candidates.length)return candidates[0].photo;
 }
 return null;
}
function applyModelPhotoToDom(key,photo){
 document.querySelectorAll('.vehiclePicture[data-pn-key]').forEach(el=>{
  if(el.dataset.pnKey!==key)return;
  el.removeAttribute('data-pn-key');
  if(!photo)return;
  const v=db.vehicles.find(x=>modelPhotoKey(x)===key);
  // Avoid replacing a form preview if user selected a local photo while a lookup was running.
  if(el.closest('#carPhotoPreview')){
   const form=document.getElementById('vehicleEntryForm');
   if(form?.elements.namedItem('vehiclePhoto')?.files?.length)return;
  }
  const old=el.innerHTML;
  const pic=document.createElement('img');pic.alt='Example car photo; model year may differ';pic.loading='lazy';pic.referrerPolicy='no-referrer';
  pic.onerror=()=>{el.innerHTML=old;el.dataset.photoFailed='true'};
  pic.src=photo.url;
  el.innerHTML='';el.appendChild(pic);
  const tag=document.createElement('span');tag.className='imageType';tag.textContent='Example model photo';el.appendChild(tag);
  const credit=document.createElement('div');credit.className='pictureCredit';
  credit.append('Photo: '+(photo.author||'Wikimedia Commons')+' · ');
  const source=document.createElement('a');source.href=photo.page;source.target='_blank';source.rel='noopener noreferrer';source.textContent='source';credit.appendChild(source);credit.append(' · ');
  const link=document.createElement('a');link.href=photo.licenseUrl;link.target='_blank';link.rel='noopener noreferrer';link.textContent=photo.license;credit.appendChild(link);el.appendChild(credit);
 });
}
function hydrateVehiclePhotos(){
 const unmatched=[...document.querySelectorAll('.vehiclePicture[data-pn-key]')];
 for(const el of unmatched){
  const key=el.dataset.pnKey;
  const v=db.vehicles.find(x=>modelPhotoKey(x)===key)||(()=>{
   const form=el.closest('#carPhotoPreview')?.parentElement?.parentElement?.closest('form');
   if(!form)return null;
   const f=form.elements;
   return {year:f.namedItem('year')?.value,make:f.namedItem('make')?.value,model:f.namedItem('model')?.value};
  })();
  if(!v?.make||!v?.model||v.make==='Other / not listed'||v.model==='Other / not listed')continue;
  const cached=modelPhotoCache[key];
  if(cached&&Date.now()-cached.checked<(cached.photo?PHOTO_CACHE_TTL:PHOTO_NEGATIVE_TTL)){
    applyModelPhotoToDom(key,cached.photo);continue;
  }
  if(modelPhotoRequests.has(key))continue;
  const request=queryCommonsPhotos(v).then(photo=>{
   modelPhotoCache[key]={photo,checked:Date.now()};
   try{const entries=Object.entries(modelPhotoCache).sort((a,b)=>b[1].checked-a[1].checked).slice(0,75);localStorage.setItem(PHOTO_CACHE_KEY,JSON.stringify(Object.fromEntries(entries)))}catch{}
   applyModelPhotoToDom(key,photo);
  }).catch(()=>{document.querySelectorAll('.vehiclePicture[data-pn-key]').forEach(node=>{if(node.dataset.pnKey===key)node.removeAttribute('data-pn-key')})}).finally(()=>modelPhotoRequests.delete(key));
  modelPhotoRequests.set(key,request);
 }
}

function save(){try{localStorage.setItem(STORE,JSON.stringify(db));if(typeof account!=='undefined'&&account.syncActive&&account.signedIn){const body=JSON.stringify(db);if(body.length<=700000)cloudBridge()?.saveCloud(body);else {account.syncActive=false;account.cloudMessage='Cloud sync paused: receipt photos are too large';}}return true}catch{notify('Storage is full. Export a backup or use smaller receipt photos.');return false}}
function notify(m){const n=$('toast');n.textContent=m;n.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>n.classList.remove('show'),4200)}
function go(p){page=p;render();window.scrollTo({top:0,behavior:'instant'})}
const nav=[['home','Dashboard','home'],['drive','Trips','drive'],['service','Maintenance','wrench'],['shops','Mechanics','map'],['more','More','more']];
function navigation(){ $('sideNav').innerHTML=nav.map(([key,label,ico])=>`<button class="sideItem ${page===key?'active':''}" data-page="${key}">${icon(ico)} ${label}</button>`).join('')+`<div class="sidebarFoot">Built for everyday drivers.<br>Cloud sync is optional.<br><br>Prototype v0.1.3 · PitNudge is a working name.</div>`; $('bottomNav').innerHTML=nav.map(([key,label,ico])=>`<button class="bottomItem ${page===key?'active':''}" data-page="${key}">${icon(ico,22)}<span>${label}</span></button>`).join('') }
function topVehicle(){const select=$('currentVehicle');select.innerHTML=db.vehicles.length?db.vehicles.map(v=>`<option value="${v.id}" ${v.id===db.selected?'selected':''}>${esc(v.year+' '+v.make+' '+v.model)}</option>`).join(''):'<option value="">No vehicles yet</option>';select.disabled=!db.vehicles.length}
function intro(kicker,title,description,action=''){return `<div class="pageIntro"><div><div class="eyebrow">${kicker}</div><h1>${title}</h1><p class="introText">${description}</p></div>${action}</div>`}
function noVehicle(){return `<div class="empty"><div style="font-size:45px">🚘</div><h2>Start with your vehicle</h2><p>Add your car or truck and its current odometer. We’ll build your maintenance dashboard around it.</p><button class="button" data-action="newVehicle">${icon('plus',17)} Add my vehicle</button></div>`}
function monthsAfter(d,n){let x=new Date(d+'T12:00:00');if(!Number.isFinite(+x))return null;let day=x.getDate();x.setDate(1);x.setMonth(x.getMonth()+n);let last=new Date(x.getFullYear(),x.getMonth()+1,0).getDate();x.setDate(Math.min(day,last));return x}
function serviceInfo(v,key){let config={...DEFAULTS[key],...(v.schedules?.[key]||{})};let last=db.records.filter(r=>r.vehicleId===v.id && r.kind==='service' && r.service===key).sort((a,b)=>b.date.localeCompare(a.date)||b.mileage-a.mileage)[0];if(!last)return {...config,key,status:'unknown',desc:'No service recorded — enter your last service to start reminders',remaining:null,progress:0};let dueAt=Number(last.mileage)+Number(config.miles);let remain=dueAt-Number(v.mileage);let dateDue=monthsAfter(last.date,Number(config.months));let daysLeft=dateDue?Math.ceil((dateDue.getTime()-Date.now())/86400000):null;let status=remain<=0||(daysLeft!==null&&daysLeft<=0)?'due':remain<=Math.max(500,config.miles*.10)||(daysLeft!==null&&daysLeft<=30)?'soon':'good';let description=status==='due'?'Service is due or overdue':`${miles(Math.max(0,remain))} mi remaining${daysLeft===null?'':` · due ${dateDue.toLocaleDateString('en-US',{month:'short',year:'numeric'})}`}`;return {...config,key,status,desc:description,remaining:remain,progress:Math.min(100,Math.max(0,100-remain/config.miles*100)),last,dueAt,dateDue,daysLeft};}
const statusLabel={due:'Due now',soon:'Due soon',good:'On track',unknown:'Set up'};
const severity={due:0,soon:1,unknown:2,good:3};
function serviceTile(s,mini=false){return `<div class="serviceItem"><div style="display:flex;align-items:flex-start;gap:11px;min-width:0"><div class="itemIcon">${icon(s.icon)}</div><div><div class="serviceTitle">${esc(s.name)}</div><div class="serviceMeta">${esc(s.desc)}</div>${mini?'':`<div class="mini">Schedule: ${miles(s.miles)} mi or ${s.months} months · whichever comes first</div>`}</div></div><div class="serviceInfo"><span class="status ${s.status}">${statusLab