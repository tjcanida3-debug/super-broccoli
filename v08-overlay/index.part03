el[s.status]}</span><button class="button sm secondary" data-action="service" data-service="${s.key}">${s.status==='unknown'?'Set up':'Log'}</button>${mini?'':`<button class="button sm ghost" title="Edit interval" aria-label="Edit ${esc(s.name)} interval" data-action="interval" data-service="${s.key}">${icon('edit',14)}</button>`}</div></div>`}
function home(){let v=vehicle();if(!v)return intro('Welcome to PitNudge','Take care of your ride','Your personal maintenance companion.')+noVehicle();let stats=Object.keys(DEFAULTS).map(k=>serviceInfo(v,k)).sort((a,b)=>severity[a.status]-severity[b.status]);let urgent=stats.filter(x=>x.status==='due'||x.status==='soon').length;let total=db.records.filter(r=>r.vehicleId===v.id).reduce((s,r)=>s+Number(r.amount||0),0);let distance=db.trips.filter(t=>t.vehicleId===v.id).reduce((s,t)=>s+Number(t.miles||0),0);return intro('My garage','Your dashboard','Stay ahead of maintenance and keep all your vehicle records together.',`<button class="button sm secondary" data-action="newVehicle">${icon('plus',15)} Add vehicle</button>`)+`<div class="stack"><div class="panel hero"><div class="heroRow"><div><div class="heroLabel">${esc(vehicleName(v))}</div><div class="heroCount metric">${miles(Number(v.mileage) + (nativeMileageState.running && nativeMileageState.recording && nativeMileageState.vehicleId===v.id ? Number(nativeMileageState.miles||0) : 0))} <span style="font-size:15px;letter-spacing:0">mi</span></div><div class="muted small" style="margin-top:7px">${nativeMileageState.running && nativeMileageState.recording && nativeMileageState.vehicleId===v.id ? 'Live GPS odometer estimate · saved after trip' : 'Estimated odometer · manually correct anytime'}</div></div>${vehiclePicture(v,'hero')}</div><div class="actions space"><button class="button sm" data-action="editVehicle">${icon('edit',16)} Update odometer</button><button class="button sm secondary" data-page="drive">${icon('drive',16)} Track a trip</button></div></div><div class="grid3"><div class="panel"><div class="statLabel">Needs attention</div><div class="statNum ${urgent?'amber':'green'}">${urgent}</div><div class="mini">Upcoming or due</div></div><div class="panel"><div class="statLabel">Logged miles</div><div class="statNum">${miles(distance)}</div><div class="mini">Across your trips</div></div><div class="panel"><div class="statLabel">Recorded costs</div><div class="statNum smallnum">${money(total)}</div><div class="mini">All saved expenses</div></div></div><section class="panel"><div class="panelHead"><h2>Maintenance overview</h2><button class="button sm ghost" data-page="service">See all ${icon('arrow',15)}</button></div>${stats.slice(0,4).map(s=>serviceTile(s,true)).join('')}</section><div class="grid2"><div class="panel"><div class="panelHead"><h2>Need a mechanic?</h2>${icon('pin')}</div><p class="muted small">Find local oil-change shops, tire shops, and repair professionals.</p><button class="button secondary" data-page="shops">Find nearby shops ${icon('arrow',16)}</button></div><div class="panel"><div class="panelHead"><h2>Keep your receipts</h2>${icon('receipt')}</div><p class="muted small">Save service details and a photo of each receipt on this device.</p><button class="button secondary" data-action="service">Log a service ${icon('arrow',16)}</button></div></div></div>`}
function drive(){let v=vehicle();if(!v)return intro('Mileage','Track your trips','Track personal and work driving.')+noVehicle();let trips=db.trips.filter(t=>t.vehicleId===v.id).sort((a,b)=>b.date.localeCompare(a.date));const business=trips.filter(t=>t.type==='business').reduce((a,t)=>a+Number(t.miles),0);const personal=trips.filter(t=>t.type!=='business').reduce((a,t)=>a+Number(t.miles),0);return intro('Mileage','Drive tracker',nativeMileageAvailable()?'Turn on automatic driving detection once. It stays watching for your next drive until you switch it off. Android may suspend it if you reboot, force-stop the app, or restrict its battery use.':'GPS tracking is available while the app is open.',`<button class="button sm secondary" data-action="trip">${icon('plus',16)} Add trip</button>`)+`<div class="stack"><section class="panel"><div class="labelRow"><h2>Trip detection</h2><span class="status ${activeTrip||nativeMileageState.running?'good':'unknown'}" id="tripStatus">${activeTrip?'Recording':nativeMileageState.running?'Watching for driving':nativeMileageStarting?'Starting GPS':'Not recording'}</span></div><p class="muted small" style="margin:10px 0 20px">${activeTrip?(nativeMileageAvailable()?'GPS tracking stays active with the screen locked. Finish the trip to save the estimated miles.':'Keep PitNudge open while driving. Distance updates when accurate GPS readings arrive.'):(nativeMileageState.running?'Waiting for vehicle movement. A persistent Android notification lets you stop tracking.':nativeMileageAvailable()?'Turn on automatic detection once and keep its notification running between drives. Or start a trip manually.':'Enable automatic detection to watch for driving while the app is open, or start a trip manually.')}</p><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap"><label class="toggle"><input type="checkbox" id="autoDetect" ${db.autoDetect?'checked':''}/> ${nativeMileageAvailable()?'Keep auto-detect ON between drives':'Auto-detect driving while open'}</label><span class="topTip">${icon('pin',14)} GPS access required</span></div>
       <label class="toggle space" style="display:flex;align-items:flex-start;gap:10px"><input type="checkbox" id="saveRouteMaps" ${db.saveRouteMaps?'checked':''}/><span><strong>Save trip route maps</strong><span class="small muted" style="display:block;font-weight:400">Optional: record map points for new trips. Routes are saved with your trip history and included in your optional cloud backup. You can remove a route later.</span></span></label>
       <div class="note space" id="gpsRouteCaptureStatus" style="padding:9px 12px">${nativeMileageState.running?(nativeMileageState.saveRoute?'Map saving ON · '+(Array.isArray(nativeMileageState.route)?nativeMileageState.route.length:0)+' points captured so far':'Map saving OFF · enable the checkbox above'):(db.saveRouteMaps?'Map setting ON · start tracking to capture your next route':'Route maps OFF')}</div>
       <div class="resultCard space"><div><div class="statLabel">Current trip</div><div class="valueLarge metric" id="liveMiles">${activeTrip?miles(activeTrip.miles):'0'} <span style="font-size:14px">mi</span></div><div class="small muted" id="liveKind">${activeTrip?`Recording for ${esc(vehicleName(db.vehicles.find(x=>x.id===activeTrip.vehicleId)))}`:(nativeMileageState.running?esc(nativeMileageState.message||'Watching for driving'):'No trip in progress')}</div></div><div>${icon('drive',38)}</div></div><div class="actions space">${nativeMileageState.running && nativeMileageState.mode==='auto' ?
  (activeTrip?`<button class="button" data-action="stopTrip">${icon('check',18)} Finish current drive</button>`:'<span class="status good" style="padding:12px">Monitoring stays ON for your next drive</span>')+
  '<button class="button ghost" data-action="disableAuto">Turn off auto-detect</button>':
  `<button class="button" data-action="${activeTrip?'stopTrip':'startTrip'}">${icon(activeTrip?'check':'drive',18)} ${activeTrip?'Finish trip':nativeMileageState.running?'Stop monitoring':'Start GPS trip'}</button>`}${activeTrip?'<button class="button ghost" data-action="cancelTrip">Discard trip</button>':''}${activeTrip&&Array.isArray(activeTrip.route)&&activeTrip.route.length>1?'<button class="button secondary" data-action="viewLiveRoute">View live map</button>':''}</div>${activeTrip?`<div class="space"><label class="field">Trip category<select id="liveCategory"><option value="personal" ${activeTrip.type==='personal'?'selected':''}>Personal</option><option value="business" ${activeTrip.type==='business'?'selected':''}>Business (DoorDash, work, etc.)</option></select></label></div>`:''}</section><div class="note"><strong>GPS estimates:</strong> In the Android app, enable tracking <em>while PitNudge is open</em>; then your phone can lock while a visible tracking notification is running. Auto-detect stays on between drives until you deliberately switch it off; it finishes each drive after about 3 minutes stationary and keeps watching. Tapping Finish current drive also keeps auto-detect on. Android may suspend tracking after a force-stop, device restart or aggressive battery restrictions; reopen PitNudge if that happens. Continuous monitoring uses extra battery. GPS may miss miles indoors or without signal. Turn on <strong>Save trip route maps</strong> to compare your route with the distance your car reports. Earlier trips cannot be mapped because they did not record coordinates. Check your dashboard odometer periodically.</div><div class="grid2"><div class="panel"><div class="statLabel">Business miles logged</div><div class="statNum metric">${miles(business)}</div></div><div class="panel"><div class="statLabel">Personal miles logged</div><div class="statNum metric">${miles(personal)}</div></div></div><section class="panel"><div class="panelHead"><h2>Recent trips</h2><button class="button sm ghost" data-action="trip">${icon('plus',14)} Manual trip</button></div>${trips.length?trips.slice(0,15).map(t=>`<div class="record"><div><div style="font-weight:750">${miles(t.miles)} miles <span class="chip">${t.type==='business'?'Business':'Personal'}</span></div><div class="small muted">${humanDate(t.date)} · ${t.source==='gps'?'GPS estimate':'Manual entry'}${t.note?' · '+esc(t.note):''}</div></div><div class="actions">${Array.isArray(t.route)&&t.route.length>1?`<button class="button sm secondary" data-action="viewTripRoute" data-id="${t.id}">${icon('pin',14)} View map</button>`:''}<button class="button sm secondary" data-action="editTrip" data-id="${t.id}">Edit</button><button class="button sm ghost" data-action="deleteTrip" data-id="${t.id}" aria-label="Delete trip">${icon('trash',16)}</button></div></div>`).join(''):'<div class="empty"><p>No trips recorded yet. Start GPS tracking or add your first drive manually.</p></div>'}</section></div>`}
function service(){let v=vehicle();if(!v)return intro('Care schedule','Maintenance','See what your vehicle needs next.')+noVehicle();let s=Object.keys(DEFAULTS).map(k=>serviceInfo(v,k)).sort((a,b)=>severity[a.status]-severity[b.status]);return intro('Vehicle care','Maintenance','Default intervals are examples only. Adjust each reminder to your owner’s manual.',`<button class="button sm" data-action="service">${icon('plus',16)} Log service</button>`)+`<div class="stack"><div class="banner"><strong>Vehicle-specific advice:</strong> Recommended service timing varies by car, oil type, driving conditions, and manufacturer. These starter reminders are customizable and are not official service schedules.</div><section class="panel"><div class="panelHead"><h2>${esc(vehicleName(v))}</h2><span class="topTip">${miles(v.mileage)} mi</span></div>${s.map(x=>serviceTile(x)).join('')}</section><section class="panel"><div class="panelHead"><h2>DIY help</h2>${icon('book')}</div><p class="muted small">Basic owner checklists, plus a quick way to find local professional help.</p><div class="actions"><button class="button secondary" data-action="diy">See DIY basics</button><button class="button ghost" data-page="shops">Find a mechanic</button></div></section></div>`}
function shopLink(category){let queries={mechanic:'auto repair shops near me',oil:'oil change near me',tires:'tire shops near me',brakes:'brake repair shops near me',battery:'car battery replacement near me',towing:'auto towing near me'};return 'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(queries[catego