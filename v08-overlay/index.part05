=>String(t.date).startsWith(String(yr)));let vehicleCosts=db.records.filter(r=>String(r.date).startsWith(String(yr))).reduce((s,r)=>s+Number(r.amount||0),0);return `<div class="stack"><div class="panel"><div class="eyebrow">${yr} tax organization</div><div class="grid2 space"><div><div class="statLabel">Logged business mileage</div><div class="valueLarge metric">${miles(business)} <span style="font-size:14px">mi</span></div></div><div><div class="statLabel">Vehicle costs recorded</div><div class="valueLarge metric">${money(vehicleCosts)}</div></div></div><p class="muted small">${all.length} trips recorded this year · ${trips.length} categorized as business.</p><div class="actions space"><button class="button" data-action="exportTrips">${icon('download',16)} Export trips CSV</button><button class="button secondary" data-action="exportCosts">${icon('download',16)} Export costs CSV</button></div></div><div class="banner">A mileage record is not automatically a tax deduction. Tax eligibility and which method to use depend on the vehicle’s business use, documentation, and IRS rules. The standard mileage method usually cannot be combined with separate deductions for routine vehicle maintenance. PitNudge does not calculate taxes or file returns.</div><section class="panel"><div class="panelHead"><h2>Helpful tax records</h2>${icon('file')}</div><p class="muted small">Mark every trip as personal or business, keep dates and purposes for business travel, and save receipts. You can export both logs for your tax preparer.</p><div class="actions"><button class="button secondary" data-page="drive">Review trips</button><button class="button ghost" data-more="records">Review receipts</button><a class="button ghost" rel="noopener noreferrer" href="https://www.irs.gov/taxtopics/tc510">IRS business vehicle guidance</a></div></section></div>`}
function settingsSection(){return `<div class="stack"><section class="panel"><h2>Backup your data</h2><p class="muted small">Your local data is saved on this device. Account backup will be optional once Google/Apple sign-in is configured. The Chrome prototype stays separate. Export a JSON backup (including vehicle and receipt photos) for safekeeping.</p><div class="actions space"><button class="button secondary" data-action="backup">${icon('download',15)} Download backup</button><button class="button ghost" data-action="import">Import backup</button></div></section><section class="panel"><h2>Privacy and GPS</h2><p class="muted small">Route maps are <strong>optional</strong> and off until you turn them on in Trips. If enabled, the app saves a simplified GPS line with the trip; the route is included in your optional account cloud backup and JSON exports. Opening the street map sends map-area requests to OpenStreetMap. You can delete a trip route without deleting its mileage.</p><label class="toggle space"><input type="checkbox" id="autoDetectSettings" ${db.autoDetect?'checked':''}/> ${nativeMileageAvailable()?'Auto-detect driving (screen may lock)':'Try automatic driving detection while open'}</label></section><section class="panel"><h2>About this prototype</h2><p class="muted small">PitNudge is a working name, not a cleared trademark. Android GPS tracking is opt-in, uses a persistent notification, and can continue when the screen is locked. Fully passive tracking without first activating monitoring is not supported. Current maintenance intervals are editable examples.</p><button class="button danger sm" data-action="reset">Delete all local data</button></section><input type="file" id="importFile" accept="application/json,.json" style="display:none"/></div>`}
function render(){if(db.selected&&!vehicle())db.selected=db.vehicles[0]?.id||null;if(!db.selected&&db.vehicles.length)db.selected=db.vehicles[0].id;topVehicle();navigation();$('content').innerHTML=({home,drive,service,shops,more}[page]||home)();setTimeout(hydrateVehiclePhotos,0)}
function showModal(title,body,callback){$('modalTitle').textContent=title;$('modalContent').innerHTML=body;$('modal').showModal();const form=$('modalContent').querySelector('form');if(form)form.addEventListener('submit',async e=>{e.preventDefault();const btn=form.querySelector('[type=submit]');if(btn)btn.disabled=true;try{const success=await callback(new FormData(form),form);if(success!==false){$('modal').close();render()}}catch(err){notify(err?.message||'Could not save your entry.')}finally{if(btn)btn.disabled=false}})}
const field=(label,name,required=false,type='text',value='',extra='')=>`<label class="field">${label}<input name="${name}" type="${type}" ${required?'required':''} value="${esc(value)}" ${extra}/></label>`;
