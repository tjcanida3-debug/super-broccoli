vehicles.length}
function intro(kicker,title,description,action=''){return `<div class="pageIntro"><div><div class="eyebrow">${kicker}</div><h1>${title}</h1><p class="introText">${description}</p></div>${action}</div>`}
function noVehicle(){return `<div class="empty"><div style="font-size:45px">🚘</div><h2>Start with your vehicle</h2><p>Add your car or truck and its current odometer. We’ll build your maintenance dashboard around it.</p><button class="button" data-action="newVehicle">${icon('plus',17)} Add my vehicle</button></div>`}
function monthsAfter(d,n){let x=new Date(d+'T12:00:00');if(!Number.isFinite(+x))return null;let day=x.getDate();x.setDate(1);x.setMonth(x.getMonth()+n);let last=new Date(x.getFullYear(),x.getMonth()+1,0).getDate();x.setDate(Math.min(day,last));return x}
function serviceInfo(v,key){let config={...DEFAULTS[key],...(v.schedules?.[key]||{})};let last=db.records.filter(r=>r.vehicleId===v.id && r.kind==='service' && r.service===key).sort((a,b)=>b.date.localeCompare(a.date)||b.mileage-a.mileage)[0];if(!last)return {...config,key,status:'unknown',desc:'No service recorded — enter your last service to start reminders',remaining:null,progress:0};let dueAt=Number(last.mileage)+Number(config.miles);let remain=dueAt-Number(v.mileage);let dateDue=monthsAfter(last.date,Number(config.months));let daysLeft=dateDue?Math.ceil((dateDue.getTime()-Date.now())/86400000):null;let status=remain<=0||(daysLeft!==null&&daysLeft<=0)?'due':remain<=Math.max(500,config.miles*.10)||(daysLeft!==null&&daysLeft<=30)?'soon':'good';let description=status==='due'?'Service is due or overdue':`${miles(Math.max(0,remain))} mi remaining${daysLeft===null?'':` · due ${dateDue.toLocaleDateString('en-US',{month:'short',year:'numeric'})}`}`;return {...config,key,status,desc:description,remaining:remain,progress:Math.min(100,Math.max(0,100-remain/config.miles*100)),last,dueAt,dateDue,daysLeft};}
const statusLabel={due:'Due now',soon:'Due soon',good:'On track',unknown:'Set up'};
const severity={due:0,soon:1,unknown:2,good:3};
function serviceTile(s,mini=false){return `<div class="serviceItem"><div style="display:flex;align-items:flex-start;gap:11px;min-width:0"><div class="itemIcon">${icon(s.icon)}</div><div><div class="serviceTitle">${esc(s.name)}</div><div class="serviceMeta">${esc(s.desc)}</div>${mini?'':`<div class="mini">Schedule: ${miles(s.miles)} mi or ${s.months} months · whichever comes first</div>`}</div></div><div class="serviceInfo"><span class="status ${s.status}">${statusLabel[s.status]}</span><button class="button sm secondary" data-action="service" data-service="${s.key}">${s.status==='unknown'?'Set up':'Log'}</button>${mini?'':`<button class="button sm ghost" title="Edit interval" aria-label="Edit ${esc(s.name)} interval" data-action="interval" data-service="${s.key}">${icon('edit',14)}</button>`}</div></div>`}
function home(){let v=vehicle();if(!v)return intro('Welcome to PitNudge','Take care of your ride','Your personal maintenance companion.')+noVehicle();let stats=Object.keys(DEFAULTS).map(k=>serviceInfo(v,k)).sort((a,b)=>severity[a.status]-severity[b.status]);let urgent=stats.filter(x=>x.status==='due'||x.status==='soon').length;let total=db.records.filter(r=>r.vehicleId===v.id).reduce((s,r)=>s+Number(r.amount||0),0);let distance=db.trips.filter(t=>t.vehicleId===v.id).reduce((s,t)=>s+Number(t.miles||0),0);return intro('My garage','Your dashboard','Stay ahead of maintenance and keep all your vehicle records together.',`<button class="button sm secondary" data-action="newVehicle">${icon('plus',15)} Add vehicle</button>`)+`<div class="stack"><div class="panel hero"><div class="heroRow"><div><div class="heroLabel">${esc(vehicleName(v))}</div><div class="heroCount metric">${miles(Number(v.mileage) + (nativeMileageState.running && nativeMileageState.recording && nativeMileageState.vehicleId===v.id ? Number(nativeMileageState.miles||0) : 0))} <span style="font-size:15px;letter-spacing:0">mi</span></div><div class="muted small" style="margin-top:7px">${nativeMileageState.running && nativeMileageState.recording && nativeMileageState.vehicleId===v.id ? 'Live GPS odometer estimate · saved after trip' : 'Estimated odometer · manually correct anytime'}</div></div>${vehiclePicture(v,'hero')}</div><div class="actions space"><button class="button sm" data-action="editVehicle">${icon('edit',16)} Update odometer</button><button class="button sm secondary" data-page="drive">${icon('drive',16)} Track a trip</button></div></div><div class="grid3"><div class="panel"><div class="statLabel">Needs attention</div><div class="statNum ${urgent?'amber':'green'}">${urgent}</div><div class="mini">Upcoming or due</div></div><div class="panel"><div class="statLabel">Logged miles</div><div class="statNum">${miles(distance)}</div><div class="mini">Across your trips</div></div><div class="panel"><div class="statLabel">Recorded costs</div><div class="statNum smallnum">${money(total)}</div><div class="mini">All saved expenses</div></div></div><section class="panel"><div class="panelHead"><h2>Maintenance overview</h2><button class="button sm ghost" data-page="service">See all ${icon('arrow',15)}</button></div>${stats.slice(0,4).map(s=>serviceTile(s,true)).join('')}</section><div class="grid2"><div class="panel"><div class="panelHead"><h2>Need a mechanic?</h2>${icon('pin')}</div><p class="muted small">Find local oil-change shops, tire shops, and repair professionals.</p><button class="button secondary" data-page="shops">Find nearby shops ${icon('arrow',16)}</button></div><div class="panel"><div class="panelHead"><h2>Keep your receipts</h2>${icon('receipt')}</div><p class="muted small">Save service details and a photo of each receipt on this device.</p><button class="button secondary" data-action="service">Log a service ${icon('arrow',16)}</button></div></div></div>`}
function drive(){let v=vehicle();if(!v)return intro('Mileage','Track your trips','Track personal and work driving.')+noVehicle();let trips=db.trips.filter(t=>t.vehicleId===v.id).sort((a,b)=>b.date.localeCompare(a.date));const business=trips.filter(t=>t.type==='business').reduce((a,t)=>a+Number(t.miles),0);const personal=trips.filter(t=>t.type!=='business').reduce((a,t)=>a+Number(t.miles),0);return intro('Mileage','Drive tracker',nativeMileageAvailable()?'Turn on automatic driving detection once. It stays watching for your next drive until you switch it off. Android may suspend it if you reboot, force-stop the app, or restrict its battery use.':'GPS tracking is available while the app is open.',`<button class="button sm secondary" data-action="trip">${icon('plus',16)} Add trip</button>`)+`<div class="stack"><section class="panel"><div class="labelRow"><h2>Trip detection</h2><span class="status ${activeTrip||nativeMileageState.running?'good':'unknown'}" id="tripStatus">${activeTrip?'Recording':nativeMileageState.running?'Watching for driving':nativeMileageStarting?'Starting GPS':'Not recording'}</span></div><p class="muted small" style="margin:10px 0 20px">${activeTrip?(nativeMileageAvailable()?'GPS tracking stays active with the screen locked. Finish the trip to save the estimated miles.':'Keep PitNudge open while driving. Distance updates when accurate GPS readings arrive.'):(nativeMileageState.running?(nativeMileageState.bluetoothAssisted?'Waiting for your selected car Bluetooth connection, then GPS will count driving miles.':'Waiting for vehicle movement. A persistent Android notification lets you stop tracking.'):nativeMileageAvailable()?'Turn on automatic detection once and keep its notification running between drives. Or start a trip manually.':'Enable automatic detection to watch for driving while the app is open, or start a trip manually.')}</p><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap"><label class="toggle"><input type="checkbox" id="autoDetect" ${db.autoDetect?'checked':''}/> ${nativeMileageAvailable()?'Keep auto-detect ON between drives':'Auto-detect driving while open'}</label><span class="topTip">${icon('pin',14)} GPS access required</span></div>
       ${nativeMileageAvailable()&&window.NativePitNudge?.getBluetoothCarConfig?`<div class="note space" style="border-color:#39566c"><strong>🚗 Bluetooth car trigger (optional)</strong><p class="small muted" style="margin:5px 0 10px">Choose your already-paired car once. With auto-detect ON, PitNudge can wait for your car's Bluetooth to connect before turning on GPS, and finish your drive shortly after disconnecting. Leave this set to GPS-only if Bluetooth isn't supported by your car.</p>
       ${!btCarConfig.available?'<p class="small muted">Bluetooth is not available on this device.</p>':!btCarConfig.permission?'<button class="button sm secondary" data-action="requestBluetooth">Allow nearby devices</button>':!btCarConfig.enabled?'<p class="small muted">Turn on Bluetooth in Android settings first.</p>':`<label class="field" style="display:block">Car Bluetooth device<select id="bluetoothCar" style="display:block;width:100%;background:#0e1723;color:#fff;border:1px solid #364456;border-radius:10px;padding:10px;margin-top:7px"><option value="">GPS-only auto-detect (no Bluetooth trigger)</option>${(btCarConfig.devices||[]).map(d=>`<option value="${esc(d.address)}" ${btCarConfig.selectedAddress===d.address?'selected':''}>${esc(d.name||'Paired device')}</option>`).join('')}</select></label>`}
       <div class="small muted" id="bluetoothCarStatus" style="margin-top:9px">${btCarStatusText()}</div>
       <button class="button sm ghost" data-action="refreshBluetooth" style="margin-top:9px">Refresh paired devices</button></div>`:''}
       <label class="toggle space" style="display:flex;align-items:flex-start;gap:10px"><input type="checkbox" id="saveRouteMaps" ${db.saveRouteMaps?'checked':''}/><span><strong>Save trip route maps</strong><span class="small muted" style="display:block;font-weight:400">Optional: record map points for new trips. Routes are saved with your trip history and included in your optional cloud backup. You can remove a route later.</span></span></label>
       <div class="note space" id="gpsRouteCaptureStatus" style="padding:9px 12px">${nativeMileageState.running?(nativeMileageState.saveRoute?'Map saving ON · '+(Array.isArray(nativeMileageState.route)?nativeMileageState.route.length:0)+' points captured so far':'Map saving OFF · enable the checkbox above'):(db.saveRouteMaps?'Map setting ON · start tracking to capture your next route':'Route maps OFF')}</div>
       <div class="resultCard space"><div><div class="statLabel">Current trip</div><div class="valueLarge metric" id="liveMiles">${activeTrip?miles(activeTrip.miles):'0'} <span style="font-size:14px">mi</span></div><div class="small muted" id="liveKind">${activeTrip?`Recording for ${esc(vehicleName(db.vehicles.find(x=>x.id===activeTrip.vehicleId)))}`:(nativeMileageState.running?esc(nativeMileageState.message||'Watching for driving'):'No trip in progress')}</div></div><div>${icon('drive',38