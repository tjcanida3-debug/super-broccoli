y){db={...blank(),...cloud,autoDetect:false};save();account.cloudMessage='Cloud garage restored';account.syncActive=true;notify('Your garage has been restored from your account.');render();return;}
      account.syncActive=false;account.cloudMessage='Cloud and phone both have records — choose a copy';
      if(page==='more'&&moreTab==='account')render();
    }catch(e){account.cloudMessage='Could not read cloud data';account.syncActive=false;notify(account.cloudMessage)}
  },
  onCloudWrite(encoded){
    try{const s=JSON.parse(encoded); account.cloudMessage=s.ok?'Cloud backup saved':'Backup failed: '+(s.error||'Please retry');
      if(s.ok){account.syncActive=true;account.syncedAt=Date.now();}else account.syncActive=false;
      if(page==='more'&&moreTab==='account')render();if(!s.ok)notify(account.cloudMessage);
    }catch(e){console.error(e)}
  },
  onError(message){notify(message)}
};
function accountAction(action){
 const native=cloudBridge();
 if(action==='googleLogin'||action==='appleLogin'){
   if(!account.configured){notify('Cloud accounts are not configured yet. Local records are safe.');return}
   if(action==='googleLogin')native?.signInGoogle(); else native?.signInApple();return;
 }
 if(action==='accountLogout'){
   if(!confirmAction('Sign out? Your current garage will remain on this device.'))return;
   account.syncActive=false;native?.signOut();return;
 }
 if(!account.signedIn){notify('Sign in to use cloud backup.');return}
 if(action==='cloudSave'){
   const payload=JSON.stringify(db);
   if(payload.length>700000){notify('Your local backup contains too many large receipt photos for cloud sync. Export a JSON backup while we add secure photo storage.');return}
   if(account.serverSnapshot&&account.serverSnapshot!==payload&&!confirmAction('Overwrite the cloud copy with records from this phone? The older cloud copy will be replaced. Save a manual backup first if needed.'))return;
   native?.saveCloud(payload);account.cloudMessage='Saving cloud backup…';render();return;
 }
 if(action==='cloudRestore'){
   if(!account.serverSnapshot){native?.fetchCloud();notify('Checking cloud for your garage…');return}
   if(!confirmAction('Replace the garage on this phone with the account backup? Export a local backup first if you need these records.'))return;
   try{let data=JSON.parse(account.serverSnapshot);if(!Array.isArray(data.vehicles)||!Array.isArray(data.records)||!Array.isArray(data.trips))throw Error('Invalid data');
     db={...blank(),...data,autoDetect:false};save();account.syncActive=true;account.cloudMessage='Cloud garage restored';notify('Your cloud garage has been restored.');render();
   }catch(e){notify('Cloud backup could not be restored.')}return;
 }
}
function garageSection(){let arr=db.vehicles;return `<div class="stack"><div class="panelHead"><h2>My vehicles</h2><button class="button sm" data-action="newVehicle">${icon('plus',15)} Add vehicle</button></div>${arr.length?arr.map(v=>`<div class="panel">${vehiclePicture(v,'garage')}<div class="labelRow"><div style="display:flex;gap:12px;align-items:center"><div><h2>${esc(vehicleName(v))}</h2><div class="muted small">${miles(v.mileage)} miles ${db.selected===v.id?'· Selected vehicle':''}</div></div></div><span class="status ${db.selected===v.id?'good':'unknown'}">${db.selected===v.id?'Active':'In garage'}</span></div><div class="actions space"><button class="button sm secondary" data-action="chooseVehicle" data-id="${v.id}">Select</button><button class="button sm ghost" data-action="editVehicle" data-id="${v.id}">Edit & update miles</button><button class="button sm ghost" data-action="deleteVehicle" data-id="${v.id}">Remove</button></div></div>`).join(''):noVehicle()}</div>`}
function recordsSection(){let v=vehicle();if(!v)return noVehicle();let records=db.records.filter(r=>r.vehicleId===v.id).sort((a,b)=>b.date.localeCompare(a.date));let cost=records.reduce((s,r)=>s+Number(r.amount||0),0);return `<div class="stack"><div class="grid2"><div class="panel"><div class="statLabel">Recorded spending</div><div class="statNum">${money(cost)}</div><div class="small muted">For ${esc(vehicleName(v))}</div></div><div class="panel"><div class="statLabel">Saved records</div><div class="statNum">${records.length}</div><div class="small muted">Services and other vehicle costs</div></div></div><div class="actions"><button class="button" data-action="service">${icon('wrench',17)} Log service + receipt</button><button class="button secondary" data-action="expense">${icon('receipt',17)} Add other expense</button></div><div class="panel"><div class="panelHead"><h2>Service & receipt history</h2></div>${records.length?records.map(r=>`<div class="record">${r.photo?`<img class="recordPhoto" alt="Saved receipt photo" src="${esc(r.photo)}"/>`:''}<div style="flex:1;min-width:0"><div style="font-weight:800">${r.kind==='service'?(DEFAULTS[r.service]?.name||'Other service'):esc(r.category||'Other expense')}</div><div class="small muted">${humanDate(r.date)} · ${miles(r.mileage)} mi${r.note?' · '+esc(r.note):''}</div></div><div class="right"><div class="recordAmount">${money(r.amount)}</div><button class="button sm ghost" style="margin-top:7px" data-action="deleteRecord" data-id="${r.id}">Remove</button></div></div>`).join(''):'<div class="empty"><p>No receipts or maintenance costs yet. Add your first service record when you have it.</p></div>'}</div><div class="note">Receipt and vehicle photos are stored locally on this device, not uploaded to an account. Make a backup before clearing browser data or switching phones.</div></div>`}
function taxSection(){let yr=new Date().getFullYear();let trips=db.trips.filter(t=>t.type==='business'&&String(t.date).startsWith(String(yr)));let business=trips.reduce((s,t)=>s+Number(t.miles),0);let all=db.trips.filter(t=>String(t.date).startsWith(String(yr)));let vehicleCosts=db.records.filter(r=>String(r.date).startsWith(String(yr))).reduce((s,r)=>s+Number(r.amount||0),0);return `<div class="stack"><div class="panel"><div class="eyebrow">${yr} tax organization</div><div class="grid2 space"><div><div class="statLabel">Logged business mileage</div><div class="valueLarge metric">${miles(business)} <span style="font-size:14px">mi</span></div></div><div><div class="statLabel">Vehicle costs recorded</div><div class="valueLarge metric">${money(vehicleCosts)}</div></div></div><p class="muted small">${all.length} trips recorded this year · ${trips.length} categorized as business.</p><div class="actions space"><button class="button" data-action="exportTrips">${icon('download',16)} Export trips CSV</button><button class="button secondary" data-action="exportCosts">${icon('download',16)} Export costs CSV</button></div></div><div class="banner">A mileage record is not automatically a tax deduction. Tax eligibility and which method to use depend on the vehicle’s business use, documentation, and IRS rules. The standard mileage method usually cannot be combined with separate deductions for routine vehicle maintenance. PitNudge does not calculate taxes or file returns.</div><section class="panel"><div class="panelHead"><h2>Helpful tax records</h2>${icon('file')}</div><p class="muted small">Mark every trip as personal or business, keep dates and purposes for business travel, and save receipts. You can export both logs for your tax preparer.</p><div class="actions"><button class="button secondary" data-page="drive">Review trips</button><button class="button ghost" data-more="records">Review receipts</button><a class="button ghost" rel="noopener noreferrer" href="https://www.irs.gov/taxtopics/tc510">IRS business vehicle guidance</a></div></section></div>`}
function settingsSection(){return `<div class="stack"><section class="panel"><h2>Backup your data</h2><p class="muted small">Your local data is saved on this device. Account backup will be optional once Google/Apple sign-in is configured. The Chrome prototype stays separate. Export a JSON backup (including vehicle and receipt photos) for safekeeping.</p><div class="actions space"><button class="button secondary" data-action="backup">${icon('download',15)} Download backup</button><button class="button ghost" data-action="import">Import backup</button></div></section><section class="panel"><h2>Privacy and GPS</h2><p class="muted small">Route maps are <strong>optional</strong> and off until you turn them on in Trips. If enabled, the app saves a simplified GPS line with the trip; the route is included in your optional account cloud backup and JSON exports. Opening the street map sends map-area requests to OpenStreetMap. You can delete a trip route without deleting its mileage.</p><label class="toggle space"><input type="checkbox" id="autoDetectSettings" ${db.autoDetect?'checked':''}/> ${nativeMileageAvailable()?'Auto-detect driving (screen may lock)':'Try automatic driving detection while open'}</label></section><section class="panel"><h2>About this prototype</h2><p class="muted small">PitNudge is a working name, not a cleared trademark. Android GPS tracking is opt-in, uses a persistent notification, and can continue when the screen is locked. Fully passive tracking without first activating monitoring is not supported. Current maintenance intervals are editable examples.</p><button class="button danger sm" data-action="reset">Delete all local data</button></section><input type="file" id="importFile" accept="application/json,.json" style="display:none"/></div>`}
function render(){if(db.selected&&!vehicle())db.selected=db.vehicles[0]?.id||null;if(!db.selected&&db.vehicles.length)db.selected=db.vehicles[0].id;topVehicle();navigation();$('content').innerHTML=({home,drive,service,shops,more}[page]||home)();setTimeout(hydrateVehiclePhotos,0)}
function showModal(title,body,callback){$('modalTitle').textContent=title;$('modalContent').innerHTML=body;$('modal').showModal();const form=$('modalContent').querySelector('form');if(form)form.addEventListener('submit',async e=>{e.preventDefault();const btn=form.querySelector('[type=submit]');if(btn)btn.disabled=true;try{const success=await callback(new FormData(form),form);if(success!==false){$('modal').close();render()}}catch(err){notify(err?.message||'Could not save your entry.')}finally{if(btn)btn.disabled=false}})}
const field=(label,name,required=false,type='text',value='',extra='')=>`<label class="field">${label}<input name="${name}" type="${type}" ${required?'required':''} value="${esc(value)}" ${extra}/></label>`;
const OFFLINE_VEHICLES={"Acura":["CL","CSX","EL","ILX","Integra","Legend","MDX","NSX","RDX","RL","RLX","RSX","SLX","TL","TLX","TSX","ZDX"],"Alfa Romeo":["4C","Giulia","Giulietta","Milano","Stelvio","Tonale"],"AMC":["Ambassador","AMX","Concord","Eagle","Gremlin","Hornet","Javelin","Matador","Pacer","Rambler","Spirit"],"Aston Martin":["DB9","DB11","DB12","DBS","DBX","Rapide","Vanquish","Vantage"],"Audi":["80","90","100","200","A3","A4","A5","A6","A7","A8","allroad","e-tron","Q3","Q4 e-tron","Q5","Q6 e-tron","Q7","Q8","R8","RS3","RS4","RS5","RS6","