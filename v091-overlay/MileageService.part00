/**
 * Opt-in foreground location tracking. A notification remains visible while
 * tracking. Route points are saved only when the user enables optional
 * route maps. Coordinates stay in the trip log and optional cloud backup;
 * the native service does not upload them independently.
 * The WebView explicitly acknowledges finished trips after saving them into
 * its existing local/cloud garage, avoiding loss on Activity destruction.
 */
public class MileageService extends Service implements LocationListener {
    private static final String TAG = "PitNudgeMileage";
    private static final String CHANNEL = "pitnudge_mileage_channel";
    private static final int NOTIFICATION_ID = 1917;
    private static final String PREF = "pitnudge_native_mileage";
    private static final String KEY = "tracking_state";
    private static final String EVENTS = "completed_trips";
    static final String START = "com.pitnudge.app.START_MILEAGE";
    static final String STOP = "com.pitnudge.app.STOP_MILEAGE";
    static final String FINISH = "com.pitnudge.app.FINISH_CURRENT_TRIP";
    static final String CANCEL = "com.pitnudge.app.CANCEL_MILEAGE";
    static final String CATEGORY = "com.pitnudge.app.SET_CATEGORY";
    static final String ROUTE = "com.pitnudge.app.SET_ROUTE";
    static final String BLUETOOTH_CONFIG = "com.pitnudge.app.SET_BLUETOOTH_CAR";
    static final String BT_PREF = "pitnudge_bluetooth_car";
    static final String BT_ADDRESS = "address";
    static final String BT_NAME = "name";
    private static final long BT_DISCONNECT_GRACE_MS = 45_000L;
    private static final long IDLE_AUTO_FINISH_MS = 180_000L;

    private LocationManager locationManager;
    private Location lastLocation;
    private boolean running, recording, saveRoute;
    private boolean gpsRegistered=false, bluetoothConnected=false, bluetoothListenerRegistered=false;
    private String bluetoothAddress="", bluetoothName="";
    private long bluetoothDisconnectedAt=0L;
    private BluetoothAdapter bluetoothAdapter;
    private final BroadcastReceiver bluetoothReceiver = new BroadcastReceiver() {
        @Override public void onReceive(Context context, Intent intent) {
            if (!running || !btAssisted()) return;
            String action=intent.getAction();
            if (BluetoothAdapter.ACTION_STATE_CHANGED.equals(action)) {
                int state=intent.getIntExtra(BluetoothAdapter.EXTRA_STATE,-1);
                if(state==BluetoothAdapter.STATE_OFF)bluetoothLink(false);
                if(state==BluetoothAdapter.STATE_ON)queryBluetoothProfiles();
                return;
            }
            if (!hasBluetoothPermission()) return;
            BluetoothDevice device;
            if (Build.VERSION.SDK_INT>=33) device=intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE,BluetoothDevice.class);
            else device=intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE);
            if (device==null || !bluetoothAddress.equalsIgnoreCase(device.getAddress())) return;
            if (BluetoothDevice.ACTION_ACL_CONNECTED.equals(action)) bluetoothLink(true);
            else if (BluetoothDevice.ACTION_ACL_DISCONNECTED.equals(action)) bluetoothLink(false);
            else if (BluetoothA2dp.ACTION_CONNECTION_STATE_CHANGED.equals(action)
                    || BluetoothHeadset.ACTION_CONNECTION_STATE_CHANGED.equals(action)) {
                int state=intent.getIntExtra(BluetoothProfile.EXTRA_STATE,-1);
                if (state==BluetoothProfile.STATE_CONNECTED) bluetoothLink(true);
                else if (state==BluetoothProfile.STATE_DISCONNECTED) queryBluetoothProfiles();
            }
        }
    };
    private JSONArray route = new JSONArray();
    private String mode = "manual", vehicleId = "", category = "personal", startedAt = "";
    private double miles;
    private int movingHits;
    private long idleSince, lastNotificationAt, lastMotionAt;
    private final android.os.Handler checkHandler = new android.os.Handler(Looper.getMainLooper());
    private final Runnable idleCheck = new Runnable() {
        @Override public void run() {
            if (running && "auto".equals(mode) && recording && lastMotionAt > 0
                    && !(btAssisted() && bluetoothConnected)
                    && SystemClock.elapsedRealtime()-lastMotionAt > IDLE_AUTO_FINISH_MS) {
                finishCurrent(true);
                persist();
                maybeNotify();
            }
            if (running && btAssisted() && bluetoothDisconnectedAt>0
                    && SystemClock.elapsedRealtime()-bluetoothDisconnectedAt>=BT_DISCONNECT_GRACE_MS) {
                // Disconnect ends this drive; stay armed for a future car connection.
                if(recording) finishCurrent(true);
                bluetoothDisconnectedAt=0;
                stopGpsUpdates();
                message="Waiting for " + bluetoothName + " Bluetooth";
                persist();
                maybeNotify();
            }
            checkHandler.postDelayed(this,10_000L);
        }
    };
    private String message = "Waiting for GPS";

    private boolean hasBluetoothPermission() {
        return Build.VERSION.SDK_INT<31 || checkSelfPermission(Manifest.permission.BLUETOOTH_CONNECT)==PackageManager.PERMISSION_GRANTED;
    }
    private boolean btAssisted() {return "auto".equals(mode) && bluetoothAddress!=null && !bluetoothAddress.isEmpty() && hasBluetoothPermission();}
    private void readBluetoothChoice() {
        SharedPreferences p=getSharedPreferences(BT_PREF, MODE_PRIVATE);
        bluetoothAddress=p.getString(BT_ADDRESS,"");
        bluetoothName=p.getString(BT_NAME,"My car");
        if(bluetoothName==null||bluetoothName.trim().isEmpty())bluetoothName="My car";
    }
    private void stopGpsUpdates() {
        if(gpsRegistered) try {locationManager.removeUpdates(this);}catch(Exception e){Log.w(TAG,"Could not stop location updates",e);}
        gpsRegistered=false;
        lastLocation=null;
        movingHits=0;
    }
    private void startGpsUpdates() {
        if(gpsRegistered || !running) return;
        if (checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION)!=PackageManager.PERMISSION_GRANTED
                && checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION)!=PackageManager.PERMISSION_GRANTED)
            throw new SecurityException("Location permission missing");
        boolean ok=false;
        if(locationManager.isProviderEnabled(LocationManager.GPS_PROVIDER)) {
            locationManager.requestLocationUpdates(LocationManager.GPS_PROVIDER,2000L,3f,this,Looper.getMainLooper()); ok=true;
        }
        if(locationManager.isProviderEnabled(LocationManager.NETWORK_PROVIDER)) {
            locationManager.requestLocationUpdates(LocationManager.NETWORK_PROVIDER,4000L,8f,this,Looper.getMainLooper()); ok=true;
        }
        if(!ok)throw new IllegalStateException("Turn on Android Location");
        gpsRegistered=true;
        lastLocation=null;
    }
    private void bluetoothLink(boolean connected) {
        if(!running||!btAssisted())return;
        if(connected) {
            bluetoothConnected=true;
            bluetoothDisconnectedAt=0;
            try {startGpsUpdates();message=bluetoothName+" connected · watching for driving";}
            catch(Exception e){message="GPS could not start: "+e.getMessage();Log.w(TAG,"Bluetooth GPS start",e);}
        } else if(bluetoothConnected){
            bluetoothConnected=false;
            bluetoothDisconnectedAt=SystemClock.elapsedRealtime();
            message=bluetoothName+" disconnected · finishing shortly";
        }
        persist();
        ((NotificationManager)getSystemService(NOTIFICATION_SERVICE)).notify(NOTIFICATION_ID,notification());
    }
    private void queryBluetoothProfiles() {
        if(!btAssisted() || bluetoothAdapter==null || !bluetoothAdapter.isEnabled())return;
        // ACL broadcasts only cover transitions. Check profiles too when monitoring
        // starts after the car has connected or when a profile disconnects.
        for(int profile : new int[]{BluetoothProfile.HEADSET,BluetoothProfile.A2DP}) {
            try {
                bluetoothAdapter.getProfileProxy(this,new BluetoothProfile.ServiceListener() {
                    @Override public void onServiceConnected(int profileId,BluetoothProfile proxy) {
                        try {
                            if(!running || !btAssisted())return;
                            for(BluetoothDevice d : proxy.getConnectedDevices()) {
                                if(bluetoothAddress.equalsIgnoreCase(d.getAddress())) {bluetoothLink(true);break;}
                            }
                        }catch(SecurityException e){Log.w(TAG,"Bluetooth permission revoked",e);}
                        finally {try{bluetoothAdapter.closeProfileProxy(profileId,proxy);}catch(Exception ignored){}}
                    }
                    @Override public void onServiceDisconnected(int profileId) {}
                },profile);
            } catch(Exception e){Log.w(TAG,"Could not inspect Bluetooth car connection",e);}
        }
    }
    private void beginBluetoothWatch() {
        if(bluetoothListenerRegistered) {
            try {unregisterReceiver(bluetoothReceiver);}catch(Exception ignored){}
            bluetoothListenerRegistered=false;
        }
        bluetoothConnected=false;
        bluetoothDisconnectedAt=0;
        if(!btAssisted()) {
            if(running)try{startGpsUpdates();}catch(Exception e){message="GPS unavailable: "+e.getMessage();}
            return;
        }
        stopGpsUpdates();
        BluetoothManager mgr=(BluetoothManager)getSystemService(BLUETOOTH_SERVICE);
        bluetoothAdapter=mgr==null?null:mgr.getAdapter();
        if(bluetoothAdapter==null) {
            message="Bluetooth adapter not available";
            persist();
            return;
        }
        {
            IntentFilter filter=new IntentFilter();
            filter.addAction(BluetoothDevice.